---
import Logo from '../ui/Logo.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-paper-900 text-paper-200 pt-16 pb-24 lg:pb-12 border-t border-paper-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 mb-12">
      <!-- Col 1: School Identity & Regulators -->
      <div class="lg:col-span-2 space-y-4">
        <Logo variant="white" />
        <p class="text-sm text-paper-300 leading-relaxed max-w-sm">
          A premier CBSE co-educational institution (Nursery to XII) in Dehradun offering day school, day boarding, and integrated preparation for NEET, JEE & NDA.
        </p>
        <div class="pt-2 text-xs text-paper-400 space-y-1">
          <div><strong class="text-paper-200">CBSE Affiliation No.:</strong> 3530479</div>
          <div><strong class="text-paper-200">School Code:</strong> 81702</div>
          <div><strong class="text-paper-200">Managing Society:</strong> Mandakini Seva Samiti Education Society</div>
        </div>

        <!-- Social Icons -->
        <div class="flex items-center gap-4 pt-3">
          <a
            href="https://www.facebook.com/SBPSDOON"
            target="_blank"
            rel="noopener noreferrer"
            class="h-9 w-9 rounded-full bg-paper-800 flex items-center justify-center text-paper-300 hover:text-white hover:bg-crimson-700 transition-colors"
            aria-label="SBPS Facebook Page"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
          </a>
          <a
            href="https://www.youtube.com/channel/UChjGT-I6ev3a95G11FlZ6cw"
            target="_blank"
            rel="noopener noreferrer"
            class="h-9 w-9 rounded-full bg-paper-800 flex items-center justify-center text-paper-300 hover:text-white hover:bg-crimson-700 transition-colors"
            aria-label="SBPS YouTube Channel"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a
            href="https://wa.me/919690000890"
            target="_blank"
            rel="noopener noreferrer"
            class="h-9 w-9 rounded-full bg-paper-800 flex items-center justify-center text-paper-300 hover:text-white hover:bg-forest-700 transition-colors"
            aria-label="SBPS WhatsApp Channel"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 2C6.495 2 2 6.484 2 12.016c0 1.945.553 3.754 1.516 5.289L2.14 22l4.852-1.344a9.96 9.96 0 005.039 1.36c5.536 0 10.031-4.485 10.031-10.016C22.062 6.484 17.567 2 12.031 2zm0 18.258c-1.633 0-3.172-.453-4.508-1.242l-.328-.195-2.875.797.805-2.797-.211-.344a8.214 8.214 0 01-1.258-4.461c0-4.555 3.711-8.258 8.273-8.258 4.563 0 8.274 3.703 8.274 8.258 0 4.555-3.711 8.242-8.274 8.242zm4.531-6.172c-.25-.125-1.469-.727-1.695-.812-.227-.086-.391-.125-.555.125-.164.25-.648.812-.797.984-.148.164-.297.188-.547.062-.25-.125-1.055-.39-2.015-1.242-.742-.664-1.242-1.484-1.39-1.734-.149-.25-.016-.383.109-.508.117-.117.25-.297.375-.445.125-.148.164-.25.25-.414.086-.164.047-.312-.023-.438-.07-.125-.555-1.336-.766-1.836-.203-.484-.414-.422-.562-.43-.141-.008-.305-.008-.469-.008-.164 0-.43.062-.656.312-.227.25-.867.844-.867 2.062 0 1.219.891 2.398 1.016 2.562.125.164 1.75 2.664 4.234 3.742.594.258 1.055.414 1.414.523.594.195 1.141.164 1.57.102.484-.07 1.469-.602 1.68-1.18.211-.578.211-1.07.148-1.18-.063-.109-.227-.172-.477-.297z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="space-y-3">
        <h2 class="font-serif text-base font-bold text-white tracking-wide">Academics & Admissions</h2>
        <ul class="space-y-2 text-xs text-paper-300">
          <li><a href="/academics/" class="hover:text-white transition-colors">Curriculum & Pedagogy</a></li>
          <li><a href="/academics/integrated-programme/" class="hover:text-white transition-colors">NEET / JEE / NDA Coaching</a></li>
          <li><a href="/academics/day-boarding/" class="hover:text-white transition-colors">Day Boarding Facility</a></li>
          <li><a href="/academics/results/" class="hover:text-white transition-colors">Board Exam Results</a></li>
          <li><a href="/admissions/" class="hover:text-white transition-colors">Admission Process</a></li>
          <li><a href="/admissions/fees/" class="hover:text-white transition-colors">Fee Schedule</a></li>
          <li><a href="/admissions/enquire/" class="hover:text-white transition-colors text-saffron-300 font-semibold">Enquire for Admission &rarr;</a></li>
        </ul>
      </div>

      <!-- Col 3: Parents & Campus -->
      <div class="space-y-3">
        <h2 class="font-serif text-base font-bold text-white tracking-wide">Parents & Campus</h2>
        <ul class="space-y-2 text-xs text-paper-300">
          <li><a href="/notices/" class="hover:text-white transition-colors">Notices & Circulars</a></li>
          <li><a href="/parents/year-planner/" class="hover:text-white transition-colors">Academic Year Planner</a></li>
          <li><a href="/parents/policies/" class="hover:text-white transition-colors">School Rules & Policies</a></li>
          <li><a href="/parents/transfer-certificate/" class="hover:text-white transition-colors">Transfer Certificate (TC)</a></li>
          <li><a href="/parents/pay-fees/" class="hover:text-white transition-colors text-saffron-300 font-semibold">Pay Tuition Fees Online &rarr;</a></li>
          <li><a href="/campus-life/sports/" class="hover:text-white transition-colors">Sports Academies</a></li>
          <li><a href="/campus-life/gallery/" class="hover:text-white transition-colors">Photo Gallery</a></li>
        </ul>
      </div>

      <!-- Col 4: Campus Location & Baluni Group -->
      <div class="space-y-3">
        <h2 class="font-serif text-base font-bold text-white tracking-wide">Campus & Contact</h2>
        <div class="text-xs text-paper-300 space-y-2">
          <p>
            Haridwar Bypass Road, Brahmanwala, near Radhaswami Satsang Bhawan, Dehradun, Uttarakhand
          </p>
          <div>
            <strong class="text-paper-200">Phone:</strong><br />
            <a href="tel:+919690000890" class="hover:text-white">+91 96900 00890</a>, 
            <a href="tel:+919690000895" class="hover:text-white">96900 00895</a>
          </div>
          <div>
            <strong class="text-paper-200">Email:</strong><br />
            <a href="mailto:info@sbpsdoon.com" class="hover:text-white">info@sbpsdoon.com</a>
          </div>
          <div class="pt-1">
            <a
              href="https://maps.google.com/?q=Social+Baluni+Public+School+Dehradun"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-saffron-300 hover:text-saffron-200 underline"
            >
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              View on Google Maps &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Group Institutions Banner -->
    <div class="py-6 border-t border-paper-800 text-xs text-paper-400">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <span class="font-semibold text-paper-200">Baluni Group Sister Institutions:</span>
          <span class="ml-2">Baluni Classes (Dehradun) • Doon Baluni Defence Academy • Baluni Public School Kotdwar • Baluni Public School Agra</span>
        </div>
        <a href="/baluni-group/" class="text-saffron-300 hover:underline">Learn more &rarr;</a>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-6 border-t border-paper-800 flex flex-col sm:flex-row items-center justify-between text-xs text-paper-400 gap-4">
      <div>
        &copy; {currentYear} Social Baluni Public School, Dehradun. All rights reserved.
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <a href="/disclosure/" class="text-saffron-300 hover:underline font-semibold">CBSE Mandatory Public Disclosure</a>
        <span>•</span>
        <a href="/privacy/" class="hover:text-white transition-colors">Privacy Policy</a>
        <span>•</span>
        <a href="/terms/" class="hover:text-white transition-colors">Terms & Conditions</a>
        <span>•</span>
        <a href="/refund-policy/" class="hover:text-white transition-colors">Refund Policy</a>
        <span>•</span>
        <a href="/careers/" class="hover:text-white transition-colors">Careers</a>
      </div>
    </div>
  </div>
</footer>
