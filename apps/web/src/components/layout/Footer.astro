---
import Logo from '../ui/Logo.astro';
import { navSections, utilityLinks, school } from '../../data/nav';

const year = new Date().getFullYear();
---

<footer class="tie-field pb-20 text-white lg:pb-0">
  <div class="bg-crimson-800/95">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[1.3fr_2fr]">
        <div class="space-y-6">
          <Logo variant="white" />
          <address class="not-italic text-base leading-relaxed text-crimson-50">
            {school.address}
          </address>
          <ul class="space-y-1 text-base" role="list">
            {school.phones.map((p) => (
              <li><a class="hover:underline" href={`tel:${p.replace(/\s/g, '')}`} data-figure>{p}</a></li>
            ))}
            <li><a class="hover:underline" href={`mailto:${school.email}`}>{school.email}</a></li>
          </ul>
          <p class="text-sm leading-relaxed text-crimson-100">
            Affiliated to CBSE, New Delhi. Affiliation No. <span data-figure>{school.affiliation}</span>, School Code <span data-figure>{school.schoolCode}</span>.<br />
            A unit of Mandakini Seva Samiti Education Society.
          </p>
          <ul class="flex gap-5 text-sm font-semibold" role="list">
            <li><a class="underline" href="https://www.facebook.com/SBPSDOON" rel="noopener">Facebook</a></li>
            <li><a class="underline" href="https://www.youtube.com/channel/UChjGT-I6ev3a95G11FlZ6cw" rel="noopener">YouTube</a></li>
          </ul>
        </div>

        <nav aria-label="Footer" class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3">
          {navSections.map((s) => (
            <div>
              <h2 class="text-lg font-bold">
                <a href={s.href} class="hover:underline">{s.title}</a>
              </h2>
              <ul class="mt-3 space-y-2 text-[0.9375rem] text-crimson-50" role="list">
                {s.items.map((i) => (
                  <li><a class="hover:text-white hover:underline" href={i.href}>{i.title}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <div>
            <h2 class="text-lg font-bold">School</h2>
            <ul class="mt-3 space-y-2 text-[0.9375rem] text-crimson-50" role="list">
              {utilityLinks.map((i) => (
                <li><a class="hover:text-white hover:underline" href={i.href}>{i.title}</a></li>
              ))}
              <li><a class="hover:text-white hover:underline" href="/privacy/">Privacy</a></li>
              <li><a class="hover:text-white hover:underline" href="/terms/">Terms</a></li>
              <li><a class="hover:text-white hover:underline" href="/refund-policy/">Refund policy</a></li>
            </ul>
          </div>
        </nav>
      </div>

      <p class="mt-14 border-t border-white/25 pt-6 text-sm text-crimson-100">
        © <span data-figure>{year}</span> Social Baluni Public School, Dehradun. Learn to grow.
      </p>
    </div>
  </div>
</footer>
