---
// Sticky Mobile Bottom Bar: Call • WhatsApp • Enquire • Pay Fees
---

<div class="fixed bottom-0 inset-x-0 z-40 bg-paper-50/95 backdrop-blur-md border-t border-paper-300 shadow-lg lg:hidden" role="navigation" aria-label="Mobile quick actions">
  <div class="grid grid-cols-4 h-14">
    <!-- Call -->
    <a
      href="tel:+919690000890"
      class="flex flex-col items-center justify-center gap-1 text-paper-700 hover:text-crimson-800 hover:bg-paper-200/50 transition-colors active:bg-paper-200"
      aria-label="Call school admissions"
    >
      <svg class="h-5 w-5 text-crimson-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span class="text-[10px] font-semibold tracking-tight">Call</span>
    </a>

    <!-- WhatsApp -->
    <a
      href="https://wa.me/919690000890?text=Hello%20SBPS%20Admissions%20Team%2C%20I%20would%20like%20to%20enquire%20about%20admissions."
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center gap-1 text-paper-700 hover:text-forest-800 hover:bg-paper-200/50 transition-colors active:bg-paper-200"
      aria-label="Chat with school on WhatsApp"
    >
      <svg class="h-5 w-5 text-forest-700" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.031 2C6.495 2 2 6.484 2 12.016c0 1.945.553 3.754 1.516 5.289L2.14 22l4.852-1.344a9.96 9.96 0 005.039 1.36c5.536 0 10.031-4.485 10.031-10.016C22.062 6.484 17.567 2 12.031 2zm0 18.258c-1.633 0-3.172-.453-4.508-1.242l-.328-.195-2.875.797.805-2.797-.211-.344a8.214 8.214 0 01-1.258-4.461c0-4.555 3.711-8.258 8.273-8.258 4.563 0 8.274 3.703 8.274 8.258 0 4.555-3.711 8.242-8.274 8.242zm4.531-6.172c-.25-.125-1.469-.727-1.695-.812-.227-.086-.391-.125-.555.125-.164.25-.648.812-.797.984-.148.164-.297.188-.547.062-.25-.125-1.055-.39-2.015-1.242-.742-.664-1.242-1.484-1.39-1.734-.149-.25-.016-.383.109-.508.117-.117.25-.297.375-.445.125-.148.164-.25.25-.414.086-.164.047-.312-.023-.438-.07-.125-.555-1.336-.766-1.836-.203-.484-.414-.422-.562-.43-.141-.008-.305-.008-.469-.008-.164 0-.43.062-.656.312-.227.25-.867.844-.867 2.062 0 1.219.891 2.398 1.016 2.562.125.164 1.75 2.664 4.234 3.742.594.258 1.055.414 1.414.523.594.195 1.141.164 1.57.102.484-.07 1.469-.602 1.68-1.18.211-.578.211-1.07.148-1.18-.063-.109-.227-.172-.477-.297z"/>
      </svg>
      <span class="text-[10px] font-semibold tracking-tight">WhatsApp</span>
    </a>

    <!-- Enquire -->
    <a
      href="/admissions/enquire/"
      class="flex flex-col items-center justify-center gap-1 bg-crimson-700 text-white hover:bg-crimson-800 transition-colors active:bg-crimson-900"
      aria-label="Submit admission enquiry"
    >
      <svg class="h-5 w-5 text-saffron-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
      <span class="text-[10px] font-bold tracking-tight">Enquire</span>
    </a>

    <!-- Pay Fees -->
    <a
      href="/parents/pay-fees/"
      class="flex flex-col items-center justify-center gap-1 bg-forest-800 text-white hover:bg-forest-900 transition-colors active:bg-forest-950"
      aria-label="Pay school tuition fees"
    >
      <svg class="h-5 w-5 text-saffron-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <span class="text-[10px] font-bold tracking-tight">Pay Fees</span>
    </a>
  </div>
</div>
