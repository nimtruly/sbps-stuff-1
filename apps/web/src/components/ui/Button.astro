---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'gold';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
  disabled?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  target,
  rel,
  id,
  disabled = false,
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium rounded-md transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50 disabled:pointer-events-none cursor-pointer';

const variantStyles = {
  primary: 'bg-crimson-700 text-white hover:bg-crimson-800 shadow-sm active:translate-y-px focus-visible:outline-crimson-700',
  secondary: 'bg-forest-800 text-white hover:bg-forest-900 shadow-sm active:translate-y-px focus-visible:outline-forest-800',
  outline: 'border border-crimson-700 text-crimson-700 bg-transparent hover:bg-crimson-50 focus-visible:outline-crimson-700',
  ghost: 'text-paper-800 hover:text-crimson-800 hover:bg-paper-200/60 focus-visible:outline-crimson-700',
  gold: 'bg-saffron-500 text-paper-900 font-semibold hover:bg-saffron-400 shadow-sm active:translate-y-px focus-visible:outline-saffron-600',
};

const sizeStyles = {
  sm: 'text-xs px-3 py-1.5 gap-1.5',
  md: 'text-sm px-4 py-2.5 gap-2',
  lg: 'text-base px-6 py-3.5 gap-2.5 font-semibold',
};

const classes = `${baseStyles} ${variantStyles[variant]} ${sizeStyles[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel} id={id} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} id={id} disabled={disabled} {...rest}>
      <slot />
    </button>
  )
}
