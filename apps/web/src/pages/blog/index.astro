---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'News & Articles', href: '/blog/' },
];

const allArticles = await getCollection('articles');
// Filter out drafts in production listing
const publishedArticles = allArticles
  .filter((a) => !a.data.draft)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

const featuredArticle = publishedArticles[0];
const otherArticles = publishedArticles.slice(1);

const categories = Array.from(new Set(publishedArticles.map((a) => a.data.category)));
---

<PageLayout
  title="School News & Articles"
  description="Latest news, sports triumphs, student achievements, and academic updates from Social Baluni Public School, Dehradun."
  breadcrumbs={breadcrumbs}
>
  <div class="mb-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-ink mb-2 tracking-tight">
        School News & Articles
      </h2>
      <p class="text-base text-paper-700">
        Stories of excellence, campus milestones, and student achievements at SBPS Dehradun.
      </p>
    </div>
    <div class="shrink-0 flex items-center gap-2">
      <a
        href="/blog/rss.xml"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-paper-300 text-xs font-semibold text-paper-700 hover:text-crimson-800 bg-paper-50 hover:bg-paper-100 transition-colors"
        title="Subscribe to Blog RSS Feed"
      >
        <span>📡</span> Articles RSS
      </a>
    </div>
  </div>

  <!-- Category Filter Pills -->
  <div class="flex flex-wrap gap-2 mb-10">
    <a
      href="/blog/"
      class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-crimson-800 text-white shadow-xs"
    >
      All Articles ({publishedArticles.length})
    </a>
    {categories.map((cat) => (
      <a
        href={`/blog/category/${cat.toLowerCase().replace(/\s+/g, '-')}/`}
        class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-paper-100 text-paper-800 hover:bg-paper-200 border border-paper-200 transition-colors"
      >
        {cat}
      </a>
    ))}
  </div>

  <!-- Featured Article Hero Card -->
  {featuredArticle && (
    <div class="mb-14">
      <a
        href={`/blog/${featuredArticle.data.slug}/`}
        class="group block bg-paper-50 rounded-2xl border border-paper-300 overflow-hidden shadow-sm hover:border-crimson-400 hover:shadow-md transition-all"
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
          <div class="lg:col-span-7 aspect-16/10 lg:aspect-auto overflow-hidden bg-paper-200 relative">
            {featuredArticle.data.cover && (
              <img
                src={featuredArticle.data.cover}
                alt={featuredArticle.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="eager"
              />
            )}
            <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-crimson-800 text-white text-xs font-bold uppercase tracking-wider shadow">
              Featured Story
            </span>
          </div>

          <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3 text-xs text-paper-500 mb-3">
                <span class="font-bold text-saffron-700 uppercase tracking-wider">
                  {featuredArticle.data.category}
                </span>
                <span>•</span>
                <time datetime={featuredArticle.data.publishedAt}>
                  {new Date(featuredArticle.data.publishedAt).toLocaleDateString('en-IN', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </div>

              <h2 class="text-2xl sm:text-3xl font-serif font-bold text-ink group-hover:text-crimson-700 transition-colors mb-3 leading-tight">
                {featuredArticle.data.title}
              </h2>

              <p class="text-sm text-paper-700 leading-relaxed line-clamp-4 mb-6">
                {featuredArticle.data.excerpt}
              </p>
            </div>

            <div class="text-xs font-bold text-crimson-700 group-hover:text-crimson-900 flex items-center gap-1.5">
              <span>Read Full Article</span>
              <span>→</span>
            </div>
          </div>
        </div>
      </a>
    </div>
  )}

  <!-- Grid of other articles -->
  <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
    {otherArticles.map((article) => (
      <article class="group bg-paper-50 rounded-2xl border border-paper-200 overflow-hidden hover:border-crimson-300 hover:shadow-sm transition-all flex flex-col">
        <a href={`/blog/${article.data.slug}/`} class="block overflow-hidden aspect-16/10 bg-paper-200 relative">
          {article.data.cover && (
            <img
              src={article.data.cover}
              alt={article.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          )}
          <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded bg-white/90 text-ink text-xs font-bold uppercase tracking-wider backdrop-blur-xs">
            {article.data.category}
          </span>
        </a>

        <div class="p-6 flex flex-col justify-between flex-1">
          <div>
            <time datetime={article.data.publishedAt} class="text-xs text-paper-500 font-medium block mb-2">
              {new Date(article.data.publishedAt).toLocaleDateString('en-IN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <h2 class="text-lg font-serif font-bold text-ink group-hover:text-crimson-700 transition-colors mb-2 leading-snug">
              <a href={`/blog/${article.data.slug}/`}>
                {article.data.title}
              </a>
            </h2>
            <p class="text-xs text-paper-700 line-clamp-3 mb-4 leading-relaxed">
              {article.data.excerpt}
            </p>
          </div>

          <div class="pt-3 border-t border-paper-200 text-xs font-bold text-crimson-700">
            <a href={`/blog/${article.data.slug}/`} class="inline-flex items-center gap-1">
              Read More →
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>
</PageLayout>
