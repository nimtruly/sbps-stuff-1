---
import PageLayout from '../../../layouts/PageLayout.astro';
import { cms } from '../../../lib/cms';
import { formatDate } from '../../../lib/refs';

const catSlug = (c: string) => c.toLowerCase().replace(/\s+/g, '-');

export async function getStaticPaths() {
  const articles = await cms.getArticles(false);
  const cats = [...new Set(articles.map((a) => a.category))];
  return cats.map((c) => ({
    params: { cat: c.toLowerCase().replace(/\s+/g, '-') },
    props: { category: c, articles: articles.filter((a) => a.category === c) },
  }));
}

const { category, articles } = Astro.props;
---

<PageLayout
  title={category}
  description={`${category} from Social Baluni Public School, Dehradun.`}
  breadcrumbs={[{ label: 'News', href: '/blog/' }, { label: category, href: `/blog/category/${catSlug(category)}/` }]}
>
  <ul class="border-t-2 border-ink" role="list">
    {articles.map((a) => (
      <li class="border-b border-paper-300">
        <a href={`/blog/${a.slug}/`} class="group block py-6">
          <span class="text-sm text-paper-600"><time datetime={a.publishedAt}>{formatDate(a.publishedAt)}</time></span>
          <span class="mt-1 block text-2xl font-bold group-hover:text-crimson-700 group-hover:underline [font-stretch:85%]">{a.title}</span>
          <span class="measure mt-2 block text-paper-700">{a.excerpt}</span>
        </a>
      </li>
    ))}
  </ul>
  <a href="/blog/" class="mt-8 inline-block font-semibold underline">All news</a>
</PageLayout>
