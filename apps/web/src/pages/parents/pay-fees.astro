---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Parents Corner', href: '/parents/' },
  { label: 'Pay Fees Online', href: '/parents/pay-fees/' },
];

const siteSettingsList = await getCollection('siteSettings');
const settings = siteSettingsList[0]?.data;
const paymentLinks = settings?.paymentLinks || [];
---

<PageLayout
  title="Pay Fees Online"
  description="Secure online fee payments for Social Baluni Public School, Dehradun via Razorpay gateway, UPI, Net Banking, or direct bank transfer."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl">
    <div class="mb-10">
      <span class="inline-block px-3 py-1 rounded-full bg-forest-100 text-forest-800 text-xs font-bold uppercase tracking-wider mb-2">
        Instant Digital Receipts
      </span>
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-ink mb-3 tracking-tight">
        Online Fee Payment Portal
      </h2>
      <p class="text-base sm:text-lg text-paper-700 leading-relaxed">
        Pay your ward's school tuition, registration, or quarterly fees quickly and securely via Razorpay (UPI, Debit/Credit Cards, Net Banking) or through direct NEFT/RTGS bank transfer.
      </p>
    </div>

    <!-- Quick Razorpay Payment Cards -->
    <section class="mb-14">
      <h2 class="text-2xl font-serif font-bold text-ink mb-2">Direct Fee Payment Links (Razorpay)</h2>
      <p class="text-sm text-paper-700 mb-6">
        Click the appropriate fee category below. You will be redirected to the official encrypted Razorpay payment page to complete your transaction and receive an instant receipt.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {paymentLinks.map((link) => (
          <div class="p-6 rounded-2xl bg-paper-50 border border-paper-200 shadow-xs flex flex-col justify-between hover:border-crimson-400 transition-colors">
            <div>
              <div class="flex items-center justify-between gap-3 mb-2">
                <h3 class="text-lg font-bold text-ink">{link.label}</h3>
                {link.amount && (
                  <span class="text-base font-bold text-crimson-800 bg-crimson-50 px-2.5 py-0.5 rounded border border-crimson-200">
                    ₹{link.amount}
                  </span>
                )}
              </div>
              <p class="text-xs sm:text-sm text-paper-700 leading-relaxed mb-6">
                {link.description}
              </p>
            </div>

            <div>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-crimson-700 text-white font-semibold text-sm hover:bg-crimson-800 transition-colors shadow-xs"
              >
                <span>Proceed to Pay Securely</span>
                <span class="text-xs">↗</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Direct Bank Transfer Details -->
    <section class="bg-paper-100 rounded-2xl p-6 sm:p-8 border border-paper-300 mb-14">
      <h2 class="text-2xl font-serif font-bold text-ink mb-3">Direct Bank Transfer (NEFT / RTGS / IMPS)</h2>
      <p class="text-sm text-paper-700 mb-6 leading-relaxed">
        Parents wishing to make direct institutional bank transfers can use the following account details. Please mention the student's <strong>Full Name and Admission Number</strong> in the transfer remarks.
      </p>

      <div class="bg-paper-50 rounded-xl p-5 border border-paper-200 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm font-sans mb-6">
        <div>
          <span class="text-xs text-paper-500 uppercase font-bold tracking-wider block">Account Name</span>
          <span class="font-bold text-ink">Social Baluni Public School</span>
        </div>
        <div>
          <span class="text-xs text-paper-500 uppercase font-bold tracking-wider block">Bank Name</span>
          <span class="font-bold text-ink">Punjab National Bank (PNB)</span>
        </div>
        <div>
          <span class="text-xs text-paper-500 uppercase font-bold tracking-wider block">Account Number</span>
          <span class="font-mono font-bold text-ink">0135002100012345</span>
        </div>
        <div>
          <span class="text-xs text-paper-500 uppercase font-bold tracking-wider block">IFSC Code</span>
          <span class="font-mono font-bold text-ink">PUNB0013500</span>
        </div>
        <div class="sm:col-span-2">
          <span class="text-xs text-paper-500 uppercase font-bold tracking-wider block">Branch Address</span>
          <span class="text-paper-800">Haridwar Bypass Road Branch, Dehradun, Uttarakhand</span>
        </div>
      </div>

      <div class="text-xs text-paper-600 bg-white p-3.5 rounded-lg border border-paper-200">
        <strong>Important:</strong> After completing the bank transfer, kindly email the transaction UTR number / screenshot along with your ward's name and class to <a href="mailto:accounts@sbpsdoon.com" class="text-crimson-700 underline font-semibold">accounts@sbpsdoon.com</a> or WhatsApp it to <strong>+91 96900 00890</strong> for immediate fee receipt reconciliation.
      </div>
    </section>

    <!-- Fee Due Dates & Refund Policy -->
    <section class="bg-paper-50 rounded-2xl p-6 sm:p-8 border border-paper-200 text-sm space-y-4">
      <h2 class="text-lg font-serif font-bold text-ink mb-1">Quarterly Fee Schedule & Policies</h2>
      <ul class="list-disc list-inside space-y-2 text-paper-700">
        <li><strong>Quarter 1:</strong> Payable on or before 10th April</li>
        <li><strong>Quarter 2:</strong> Payable on or before 10th July</li>
        <li><strong>Quarter 3:</strong> Payable on or before 10th October</li>
        <li><strong>Quarter 4:</strong> Payable on or before 10th January</li>
        <li>Late payment surcharge is levied at ₹50 per day after the 10th of the due month.</li>
      </ul>
      <div class="pt-4 border-t border-paper-200 flex flex-wrap gap-4 text-xs font-semibold">
        <a href="/admissions/fees/" class="text-crimson-700 hover:underline">View Fee Structure →</a>
        <a href="/refund-policy/" class="text-crimson-700 hover:underline">Statutory Refund Policy →</a>
      </div>
    </section>
  </div>
</PageLayout>
