---
import PageLayout from '../../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const policies = await getCollection('policies');
  return policies.map((policy) => ({
    params: { slug: policy.data.slug },
    props: { policy },
  }));
}

const { policy } = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Parents Corner', href: '/parents/' },
  { label: 'School Policies', href: '/parents/policies/' },
  { label: policy.data.title, href: `/parents/policies/${policy.data.slug}/` },
];
---

<PageLayout
  title={policy.data.title}
  description={policy.data.summary}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-3xl">
    <div class="mb-8">
      <span class="inline-block px-3 py-1 rounded-full bg-crimson-100 text-crimson-800 text-xs font-bold uppercase tracking-wider mb-3">
        Statutory School Policy
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-ink mb-4 tracking-tight leading-tight">
        {policy.data.title}
      </h2>
      <p class="text-base sm:text-lg text-paper-700 leading-relaxed font-medium border-l-4 border-crimson-600 pl-4 py-1 bg-paper-50 rounded-r-lg">
        {policy.data.summary}
      </p>
    </div>

    <!-- Policy Content Body -->
    <div class="bg-paper-50 rounded-2xl p-6 sm:p-10 border border-paper-200 text-paper-800 leading-relaxed text-base sm:text-lg mb-10 shadow-xs whitespace-pre-line space-y-4">
      {policy.data.body}
    </div>

    <!-- Compliance & Contacts Box -->
    <div class="bg-paper-100 rounded-xl p-6 border border-paper-300 mb-10 text-sm">
      <h2 class="font-serif font-bold text-ink mb-2">Compliance & Oversight</h2>
      <p class="text-paper-700 leading-relaxed mb-4">
        This policy is subject to periodic review by the School Management Committee (SMC) and the Academic Advisory Board in adherence with CBSE bye-laws and relevant guidelines of the Government of Uttarakhand.
      </p>
      <div class="text-xs text-paper-600">
        For inquiries or grievance redressal regarding this policy, please write to: <a href="mailto:grievance@sbpsdoon.com" class="text-crimson-700 font-semibold underline">grievance@sbpsdoon.com</a>
      </div>
    </div>

    <div class="border-t border-paper-200 pt-6 flex justify-between items-center text-sm">
      <a href="/parents/policies/" class="font-semibold text-crimson-700 hover:text-crimson-900 inline-flex items-center gap-1">
        ← Back to all policies
      </a>
      <a href="/parents/" class="font-semibold text-paper-700 hover:text-ink">
        Parents Corner →
      </a>
    </div>
  </article>
</PageLayout>
