---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Parents Corner', href: '/parents/' },
  { label: 'Academic Year Planner', href: '/parents/year-planner/' },
];

const terms = [
  {
    title: 'Term I: Academic Launch & Foundation',
    duration: 'April – September',
    highlights: [
      { date: 'First Week of April', event: 'Academic Session Commences for Nursery to Class XII' },
      { date: 'May (Third Week)', event: 'Periodic Assessment I (Classes III–X & XII)' },
      { date: 'Late May – Early July', event: 'Summer Vacation & Special Integrated Coaching Camp' },
      { date: 'July (Second Week)', event: 'School Reopens; Inter-House Declamation & Science Quiz' },
      { date: 'August 15', event: 'Independence Day Celebrations & Investiture Ceremony' },
      { date: 'Mid-September', event: 'Term I / Mid-Term Examinations' },
      { date: 'Late September', event: 'Parent-Teacher Meeting (PTM) & Term I Result Declaration' },
    ],
  },
  {
    title: 'Term II: Sports, Culture & Board Examinations',
    duration: 'October – March',
    highlights: [
      { date: 'October (Early)', event: 'Baluni Inter-School Science & Mathematics Symposium' },
      { date: 'Late October / November', event: 'Diwali Break & Autumn Festivities' },
      { date: 'Mid-November', event: 'Annual Sports Meet & Athletic Championship' },
      { date: 'December (Mid)', event: 'Pre-Board Examinations I (Classes X & XII)' },
      { date: 'Late Dec – Early Jan', event: 'Winter Vacation (subject to district administration advisories)' },
      { date: 'January (Mid)', event: 'School Reopens; Pre-Board Examinations II' },
      { date: 'January 26', event: 'Republic Day Parade & NCC/Scouts Contingent' },
      { date: 'February – March', event: 'CBSE Board Examinations (Classes X & XII) & Final Annual Exams (Classes Nursery–IX & XI)' },
      { date: 'Late March', event: 'Annual Report Card Distribution & PTM' },
    ],
  },
];
---

<PageLayout
  title="Academic Year Planner & Calendar"
  description="Annual academic calendar, examination schedules, vacation dates, and parent-teacher meetings for Social Baluni Public School, Dehradun."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl">
    <div class="mb-10 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-ink mb-3 tracking-tight">
          Annual Academic Planner
        </h2>
        <p class="text-base text-paper-700 leading-relaxed max-w-2xl">
          Overview of key academic dates, assessments, holidays, cultural festivals, and parent-teacher meetings throughout the session.
        </p>
      </div>

      <div class="shrink-0">
        <a
          href="/documents/ACADEMIC-CALENDER-1.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-crimson-700 text-white font-semibold text-sm hover:bg-crimson-800 transition-colors shadow"
        >
          <span>Download Planner (PDF)</span>
          <span class="text-xs">↗</span>
        </a>
      </div>
    </div>

    <!-- Official Calendar PDF Banner -->
    <div class="bg-paper-100 rounded-2xl p-6 border border-paper-300 mb-12 flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <span class="text-3xl">🗓️</span>
        <div>
          <h2 class="text-base font-bold text-ink">Official CBSE Academic Calendar</h2>
          <p class="text-xs text-paper-600">Document approved by the School Management Committee (SMC).</p>
        </div>
      </div>
      <a
        href="/documents/ACADEMIC-CALENDER-1.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-bold text-crimson-700 hover:underline shrink-0"
      >
        View Signed PDF ↗
      </a>
    </div>

    <!-- Terms Timeline List -->
    <div class="space-y-12 mb-16">
      {terms.map((term) => (
        <section class="bg-paper-50 rounded-2xl p-6 sm:p-8 border border-paper-200 shadow-xs">
          <div class="border-b border-paper-200 pb-4 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <h2 class="text-2xl font-serif font-bold text-ink">{term.title}</h2>
            <span class="px-3 py-1 rounded-full bg-crimson-100 text-crimson-800 text-xs font-bold uppercase tracking-wider self-start sm:self-auto">
              {term.duration}
            </span>
          </div>

          <div class="space-y-4">
            {term.highlights.map((item) => (
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-4 py-2 border-b border-paper-100 last:border-0 text-sm">
                <div class="sm:col-span-4 font-bold text-crimson-900 text-xs sm:text-sm">
                  {item.date}
                </div>
                <div class="sm:col-span-8 text-paper-800">
                  {item.event}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div class="bg-paper-100 rounded-xl p-6 border border-paper-300 text-xs text-paper-600 leading-relaxed">
      <strong>Note:</strong> Exact vacation and examination dates may be adjusted in accordance with directives from the Central Board of Secondary Education (CBSE) or the District Administration of Dehradun (such as extreme weather alerts). Prompt notifications are released via our <a href="/notices/" class="underline font-medium text-crimson-700">Notices page</a> and WhatsApp broadcast.
    </div>
  </div>
</PageLayout>
