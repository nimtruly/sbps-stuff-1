---
import PageLayout from '../../../layouts/PageLayout.astro';
import GalleryLightbox from '../../../components/islands/GalleryLightbox';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const albums = await getCollection('albums');
  return albums.map((album) => ({
    params: { album: album.data.slug },
    props: { album },
  }));
}

const { album } = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Campus Life', href: '/campus-life/' },
  { label: 'Photo Gallery', href: '/campus-life/gallery/' },
  { label: album.data.title, href: `/campus-life/gallery/${album.data.slug}/` },
];
---

<PageLayout
  title={album.data.title}
  description={`Photo gallery of ${album.data.title} at Social Baluni Public School, Dehradun.`}
  breadcrumbs={breadcrumbs}
>
  <div class="mb-10">
    <div class="flex items-center gap-3 mb-3">
      <span class="px-2.5 py-0.5 rounded bg-crimson-100 text-crimson-800 text-xs font-bold uppercase tracking-wider">
        {album.data.category}
      </span>
      <span class="text-xs text-paper-500">
        {new Date(album.data.date).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-serif font-bold text-ink mb-3 tracking-tight">
      {album.data.title}
    </h2>
    <p class="text-sm text-paper-600">
      Click on any photo below to expand in full-screen view and navigate with keyboard arrow keys.
    </p>
  </div>

  <section class="mb-16">
    <GalleryLightbox client:idle images={album.data.images} />
  </section>

  <div class="border-t border-paper-200 pt-8">
    <a href="/campus-life/gallery/" class="text-sm font-semibold text-crimson-700 hover:text-crimson-900 inline-flex items-center gap-1">
      ← Back to all photo albums
    </a>
  </div>
</PageLayout>
