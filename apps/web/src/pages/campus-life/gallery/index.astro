---
import PageLayout from '../../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Campus Life', href: '/campus-life/' },
  { label: 'Photo Gallery', href: '/campus-life/gallery/' },
];

const albums = await getCollection('albums');
---

<PageLayout
  title="Campus Photo Gallery"
  description="Explore photo albums capturing campus life, infrastructure, annual sports meets, and student celebrations at Social Baluni Public School, Dehradun."
  breadcrumbs={breadcrumbs}
>
  <div class="mb-12">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-ink mb-4 tracking-tight">
      Campus Photo Galleries
    </h2>
    <p class="text-lg text-paper-700 max-w-3xl leading-relaxed">
      A visual glimpse into our vibrant community—from sports track victories and cultural festivals to hands-on science experiments and scenic campus views.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
    {albums.map((album) => (
      <a
        href={`/campus-life/gallery/${album.data.slug}/`}
        class="group block rounded-2xl overflow-hidden border border-paper-300 bg-paper-50 shadow-sm hover:border-crimson-400 hover:shadow-md transition-all flex flex-col"
      >
        <div class="aspect-16/10 overflow-hidden bg-paper-200 relative">
          <img
            src={album.data.cover}
            alt={album.data.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
          <span class="absolute bottom-3 right-3 px-3 py-1 rounded-full bg-black/70 text-white text-xs font-semibold backdrop-blur-xs flex items-center gap-1.5">
            <span>📷</span> {album.data.images.length} Photos
          </span>
          <span class="absolute top-3 left-3 px-2.5 py-1 rounded bg-saffron-500 text-ink text-xs font-bold uppercase tracking-wider">
            {album.data.category}
          </span>
        </div>

        <div class="p-6">
          <span class="text-xs text-paper-500 font-medium block mb-1">
            {new Date(album.data.date).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
          <h2 class="text-xl font-serif font-bold text-ink group-hover:text-crimson-700 transition-colors mb-2">
            {album.data.title}
          </h2>
          <span class="text-sm font-semibold text-crimson-700 inline-flex items-center gap-1">
            View Album Photos →
          </span>
        </div>
      </a>
    ))}
  </div>
</PageLayout>
