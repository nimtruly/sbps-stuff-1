---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Campus Life', href: '/campus-life/' },
  { label: 'Sports & Athletics', href: '/campus-life/sports/' },
];

const sportsList = [
  { name: '10m Air Pistol & Rifle Shooting', facility: 'Indoor electronic target shooting range', coach: 'National-level certified shooting coaches' },
  { name: 'Boxing & Combat Sports', facility: 'Standard regulation boxing ring & training gear', coach: 'NIS trained boxing instructors' },
  { name: 'Athletics & Track Events', facility: '8-lane running track, long jump pit, high jump mats', coach: 'Athletics masters training endurance & sprints' },
  { name: 'Cricket', facility: 'Turf and cement practice nets, match ground', coach: 'BCCI level certified cricket coaches' },
  { name: 'Football', facility: 'Lush green full-size football field with goalposts', coach: 'AIFF certified trainers' },
  { name: 'Basketball', facility: 'All-weather hard basketball courts with floodlights', coach: 'State-level basketball trainers' },
  { name: 'Badminton', facility: 'Indoor synthetic court with proper glare-free lighting', coach: 'Dedicated racquet sport coaches' },
  { name: 'Table Tennis', facility: 'Multi-table indoor TT arena with Stag boards', coach: 'Dedicated table tennis mentor' },
  { name: 'Taekwondo & Karate', facility: 'Dedicated martial arts dojo with safety tatami mats', coach: 'Black belt certified instructors' },
  { name: 'Volleyball', facility: 'Standard outdoor volleyball court', coach: 'Experienced physical education faculty' },
  { name: 'Lawn Tennis', facility: 'Regulation outdoor tennis court', coach: 'Professional tennis coach' },
  { name: 'Skating', facility: 'Smooth roller skating rink with boundary railings', coach: 'Speed and artistic skating trainers' },
  { name: 'Yoga & Pranayama', facility: 'Open-air green lawns and quiet indoor yoga studio', coach: 'Certified Yoga therapists and instructors' },
  { name: 'Chess', facility: 'Dedicated mind-sports activity room with tournament boards', coach: 'FIDE rated chess trainer' },
  { name: 'Kho-Kho & Traditional Games', facility: 'Soft clay ground maintaining indigenous Indian sports traditions', coach: 'Inter-school competition trainers' },
];
---

<PageLayout
  title="Sports & Athletics"
  description="15+ Olympic and traditional sports facilities, specialized academies, and state-of-the-art coaching at Social Baluni Public School, Dehradun."
  breadcrumbs={breadcrumbs}
>
  <div class="mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-crimson-100 text-crimson-800 text-xs font-bold uppercase tracking-wider mb-4">
      Physical Education & Sports
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-ink mb-4 tracking-tight">
      Champions in the Classroom, Champions on the Field
    </h2>
    <p class="text-lg text-paper-700 max-w-3xl leading-relaxed">
      At SBPS, sports are not treated as an extracurricular afterthought; they are an integral pillar of character building, physical resilience, and leadership. We offer specialized training across 15+ disciplines with dedicated coaches.
    </p>
  </div>

  <!-- Hero Highlight: 38th National Games & SFA Success -->
  <section class="bg-paper-100 border-2 border-crimson-200 rounded-2xl p-6 sm:p-8 mb-16 shadow-xs">
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      <div class="space-y-3">
        <span class="inline-block px-3 py-1 rounded-full bg-saffron-100 text-crimson-900 text-xs font-bold uppercase tracking-wider">
          Achievement Spotlight
        </span>
        <h2 class="text-2xl font-serif font-bold text-ink">
          SBPS Athletes Selected for the 38th National Games
        </h2>
        <p class="text-sm text-paper-700 max-w-2xl leading-relaxed">
          In a proud milestone for Uttarakhand and Social Baluni Public School, our student athletes earned prestigious selections to represent the state in the 38th National Games, competing across Shooting, Boxing, and Athletics.
        </p>
      </div>
      <div class="shrink-0 flex flex-col sm:flex-row gap-3">
        <a
          href="/blog/38th-national-games-sbps-students/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-crimson-700 text-white font-semibold text-sm hover:bg-crimson-800 transition-colors shadow"
        >
          Read the News Story →
        </a>
        <a
          href="/blog/sfa-inter-school-competition-2024/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-paper-200 text-ink font-semibold text-sm hover:bg-paper-300 transition-colors"
        >
          SFA Championship 2024
        </a>
      </div>
    </div>
  </section>

  <!-- 15 Sports Disciplines Grid -->
  <section class="mb-16">
    <h2 class="text-2xl sm:text-3xl font-serif font-bold text-ink mb-2">Our 15 Sports Disciplines</h2>
    <p class="text-paper-700 mb-8 max-w-2xl text-sm sm:text-base">
      Every student explores multiple sports in primary school before selecting core competitive specializations with dedicated coaching during day-boarding hours.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sportsList.map((sport, index) => (
        <div class="bg-paper-50 rounded-xl p-5 border border-paper-200 hover:border-crimson-300 transition-all shadow-2xs">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-8 rounded-full bg-crimson-100 text-crimson-800 flex items-center justify-center font-bold text-xs shrink-0">
              {index + 1}
            </span>
            <h3 class="font-bold text-base text-ink">{sport.name}</h3>
          </div>
          <p class="text-xs text-paper-700 mb-2">
            <strong class="text-paper-900">Infrastructure:</strong> {sport.facility}
          </p>
          <p class="text-xs text-paper-600">
            <strong class="text-paper-900">Coaching:</strong> {sport.coach}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Sports Academies & Partnerships -->
  <section class="bg-paper-100 rounded-2xl p-8 border border-paper-300 mb-16">
    <h2 class="text-2xl font-serif font-bold text-ink mb-4">Baluni Sports Academies</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
      <div class="bg-paper-50 p-5 rounded-xl border border-paper-200">
        <h3 class="font-bold text-base text-ink mb-2">Shooting Academy</h3>
        <p class="text-paper-700 leading-relaxed">
          High-precision 10m range with target retrieval systems, providing Olympic pathway training under certified masters.
        </p>
      </div>

      <div class="bg-paper-50 p-5 rounded-xl border border-paper-200">
        <h3 class="font-bold text-base text-ink mb-2">Cricket & Football Academy</h3>
        <p class="text-paper-700 leading-relaxed">
          Structured training sessions after school hours with video feedback, physical conditioning, and inter-school tournament circuits.
        </p>
      </div>

      <div class="bg-paper-50 p-5 rounded-xl border border-paper-200">
        <h3 class="font-bold text-base text-ink mb-2">Martial Arts & Self-Defence</h3>
        <p class="text-paper-700 leading-relaxed">
          Compulsory self-defence training for all students, with belt grading examinations conducted by certified federations.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-forest-800 text-white rounded-2xl p-8 sm:p-10 text-center">
    <h2 class="text-2xl sm:text-3xl font-serif font-bold mb-3 text-white">Experience Our Sports Facilities in Person</h2>
    <p class="text-forest-100 max-w-xl mx-auto mb-6 text-sm sm:text-base">
      Tour our athletic track, boxing ring, shooting range, and sports pavilion during a campus visit.
    </p>
    <Button href="/admissions/enquire/" variant="secondary" size="lg">Schedule a Campus Visit</Button>
  </section>
</PageLayout>
