---
import InfoPage from '../components/InfoPage.astro';

const body = "This website is published by Social Baluni Public School, Dehradun, to give information about the school.\n\n- We try to keep the information accurate and current. Official documents, fee structures and notices issued by the school office take precedence over anything on this site.\n- Photographs and text on this site belong to the school. Please ask before reusing them.\n- Links to other websites are provided for convenience; the school is not responsible for their content.\n- Information you send through the site's forms is handled as described in our [privacy page](/privacy/).\n\nQuestions: [info@sbpsdoon.com](mailto:info@sbpsdoon.com).";
---

<InfoPage
  title="Terms of use"
  description="Terms for using the Social Baluni Public School website."
  breadcrumbs={[{"label": "Terms", "href": "/terms/"}]}
  body={body}
  
  related={[["Privacy", "/privacy/"], ["Contact", "/contact/"]]}
></InfoPage>
