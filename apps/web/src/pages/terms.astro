---
import PageLayout from '../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Terms of Use', href: '/terms/' },
];
---

<PageLayout
  title="Terms of Use & Website Agreement"
  description="Terms and conditions governing the use of the official Social Baluni Public School (SBPS), Dehradun website and online services."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-3xl">
    <div class="mb-10">
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-ink mb-3 tracking-tight">
        Terms and Conditions of Use
      </h2>
      <p class="text-xs text-paper-500">
        Effective: November 2026 • Governing website access and digital student portals.
      </p>
    </div>

    <div class="space-y-8 text-paper-800 leading-relaxed text-sm sm:text-base">
      <section class="bg-paper-50 p-6 rounded-2xl border border-paper-200">
        <h2 class="text-xl font-serif font-bold text-ink mb-2">1. Acceptance of Terms</h2>
        <p>
          By accessing or using the website of Social Baluni Public School (<code>www.sbpsdoon.com</code>), you acknowledge and agree to comply with these Terms of Use, our Privacy Policy, and all applicable laws and regulations of India. If you do not agree with any part of these terms, please refrain from using the site.
        </p>
      </section>

      <section class="bg-paper-50 p-6 rounded-2xl border border-paper-200">
        <h2 class="text-xl font-serif font-bold text-ink mb-2">2. Intellectual Property Rights</h2>
        <p>
          All logos, crests, brand marks, curriculum documents, photographs, video walkthroughs, and textual content published on this website are the proprietary intellectual property of Social Baluni Public School and Mandakini Seva Samiti. Unauthorized reproduction, scraping, modification, or republication without express written authorization is prohibited.
        </p>
      </section>

      <section class="bg-paper-50 p-6 rounded-2xl border border-paper-200">
        <h2 class="text-xl font-serif font-bold text-ink mb-2">3. User Conduct & Submissions</h2>
        <p>
          Users submitting admission forms, enquiry messages, or job applications must ensure that all submitted particulars are factual, current, and accurate. Submitting fraudulent credentials, impersonating others, or attempting unauthorized access to administrative servers is strictly prohibited.
        </p>
      </section>

      <section class="bg-paper-50 p-6 rounded-2xl border border-paper-200">
        <h2 class="text-xl font-serif font-bold text-ink mb-2">4. Digital Payments & Gateway Security</h2>
        <p>
          Fee payments conducted via our integrated payment gateway (Razorpay) are processed via secured bank servers. The school is not liable for network dropouts, unauthorized access on user devices, or bank authorization delays. Transaction confirmation receipts generated by the gateway should be preserved by parents for reconciliation.
        </p>
      </section>

      <section class="bg-paper-50 p-6 rounded-2xl border border-paper-200">
        <h2 class="text-xl font-serif font-bold text-ink mb-2">5. Jurisdiction & Dispute Resolution</h2>
        <p>
          These Terms shall be governed and construed in accordance with the laws of India. Any legal disputes arising out of the use of this website or student admissions shall be subject to the exclusive jurisdiction of the competent courts in Dehradun, Uttarakhand.
        </p>
      </section>
    </div>
  </div>
</PageLayout>
