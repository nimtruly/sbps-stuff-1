---
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';

const breadcrumbs = [
  { name: 'Academics', href: '/academics/' },
  { name: 'Day Boarding', href: '/academics/day-boarding/' },
];
---

<PageLayout
  title="SBPS Day Boarding Programme"
  description="Discover the extended day boarding facility at Social Baluni Public School: supervised homework completion, hygienic meals, evening sports coaching, and peace of mind for parents."
  breadcrumbs={breadcrumbs}
>
  <div class="space-y-16 max-w-5xl mx-auto">
    <!-- Intro Pitch -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
      <div class="space-y-6">
        <div class="inline-block px-3 py-1 bg-crimson-100 text-crimson-800 rounded-full text-xs font-semibold">
          Holistic Growth Beyond Standard School Hours
        </div>
        <h2 class="font-serif text-3xl font-bold text-crimson-950 leading-tight">
          Structured Study, Sports & Nutrition — Freeing Up Family Evenings
        </h2>
        <p class="text-sm sm:text-base text-paper-700 leading-relaxed">
          The Day Boarding programme at Social Baluni Public School provides a structured sanctuary for growing children. Designed particularly to support modern working families, it transforms the post-classroom hours into productive, wholesome enrichment where homework is finished under teacher supervision, sports skills are honed, and wholesome meals are enjoyed with peers.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <Button href="/admissions/enquire/" variant="primary" size="md">
            Enquire for Day Boarding
          </Button>
          <Button href="/admissions/fees/" variant="outline" size="md">
            Check Fee Structure
          </Button>
        </div>
      </div>

      <div class="rounded-2xl overflow-hidden shadow-xl border border-paper-300">
        <img
          src="/brand/IMG_0930-scaled.jpg"
          alt="SBPS students studying in supervised environment"
          class="w-full h-full object-cover max-h-[380px]"
        />
      </div>
    </div>

    <!-- Typical Day Boarding Daily Schedule -->
    <section class="bg-paper-50 p-8 sm:p-12 rounded-2xl border border-paper-300 space-y-6">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-crimson-900">
        A Typical Day in the Life of a Day Boarder
      </h2>

      <div class="space-y-4 pt-2">
        <div class="flex items-start gap-4 p-4 rounded-xl bg-paper-100 border border-paper-200">
          <div class="font-bold text-xs text-crimson-800 bg-crimson-100 px-2.5 py-1 rounded shrink-0 tabular-nums">
            08:00 AM – 01:30 PM
          </div>
          <div>
            <div class="font-serif font-bold text-sm text-paper-900">Morning Assembly & Core CBSE Academics</div>
            <p class="text-xs text-paper-600 mt-0.5">Interactive theory lectures, laboratory practicals, language classes, and math workshops.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-xl bg-paper-100 border border-paper-200">
          <div class="font-bold text-xs text-forest-800 bg-forest-100 px-2.5 py-1 rounded shrink-0 tabular-nums">
            01:30 PM – 02:15 PM
          </div>
          <div>
            <div class="font-serif font-bold text-sm text-paper-900">Wholesome Lunch & Dining Hall Etiquette</div>
            <p class="text-xs text-paper-600 mt-0.5">Hot, balanced vegetarian lunch prepared fresh daily in the school’s hygienic kitchen.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-xl bg-paper-100 border border-paper-200">
          <div class="font-bold text-xs text-crimson-800 bg-crimson-100 px-2.5 py-1 rounded shrink-0 tabular-nums">
            02:15 PM – 03:45 PM
          </div>
          <div>
            <div class="font-serif font-bold text-sm text-paper-900">Supervised Prep & Remedial Doubt Clearance</div>
            <p class="text-xs text-paper-600 mt-0.5">Subject teachers assist students with daily homework, revisions, and Olympiad/entrance drills.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-xl bg-paper-100 border border-paper-200">
          <div class="font-bold text-xs text-saffron-800 bg-saffron-100 px-2.5 py-1 rounded shrink-0 tabular-nums">
            03:45 PM – 04:00 PM
          </div>
          <div>
            <div class="font-serif font-bold text-sm text-paper-900">Evening Refreshments & Fruit Break</div>
            <p class="text-xs text-paper-600 mt-0.5">Healthy snacks, milk, and seasonal fruits to recharge energy.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-xl bg-paper-100 border border-paper-200">
          <div class="font-bold text-xs text-crimson-800 bg-crimson-100 px-2.5 py-1 rounded shrink-0 tabular-nums">
            04:00 PM – 05:15 PM
          </div>
          <div>
            <div class="font-serif font-bold text-sm text-paper-900">Specialized Sports Academies & Co-Curricular Clubs</div>
            <p class="text-xs text-paper-600 mt-0.5">Coached training in shooting, boxing, cricket, football, martial arts, debates, or music.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-xl bg-paper-100 border border-paper-200">
          <div class="font-bold text-xs text-paper-700 bg-paper-200 px-2.5 py-1 rounded shrink-0 tabular-nums">
            05:15 PM
          </div>
          <div>
            <div class="font-serif font-bold text-sm text-paper-900">Safe Bus Dispersal for Home</div>
            <p class="text-xs text-paper-600 mt-0.5">Students return home with tasks finished, leaving evenings open for peaceful family dinner and rest.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Benefits Grid -->
    <section class="space-y-6">
      <h2 class="font-serif text-2xl font-bold text-crimson-900 border-b border-paper-300 pb-2">
        Why Parents Choose SBPS Day Boarding
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="p-6 bg-paper-50 rounded-xl border border-paper-300 space-y-2">
          <div class="font-serif font-bold text-base text-paper-900">Zero Home Tuition Burden</div>
          <p class="text-xs text-paper-600 leading-relaxed">
            With daily homework and doubt clarification completed in school prep hours, parents are freed from stressful evening tutoring.
          </p>
        </div>

        <div class="p-6 bg-paper-50 rounded-xl border border-paper-300 space-y-2">
          <div class="font-serif font-bold text-base text-paper-900">Balanced Nutrition</div>
          <p class="text-xs text-paper-600 leading-relaxed">
            Dietitian-planned vegetarian meals ensure essential vitamins, proteins, and minerals for growing bodies and minds.
          </p>
        </div>

        <div class="p-6 bg-paper-50 rounded-xl border border-paper-300 space-y-2">
          <div class="font-serif font-bold text-base text-paper-900">Elite Sports Coaching</div>
          <p class="text-xs text-paper-600 leading-relaxed">
            Students receive daily instruction by qualified sports coaches in shooting, boxing, and team games without weekend travel.
          </p>
        </div>
      </div>
    </section>
  </div>
</PageLayout>
