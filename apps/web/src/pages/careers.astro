---
import PageLayout from '../layouts/PageLayout.astro';
import { cms } from '../lib/cms';
import { school } from '../data/nav';

const openJobs = await cms.getJobs();
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const field = 'mt-1 h-12 w-full border-2 border-paper-400 bg-white px-3 text-base focus:border-ink focus:outline-none';
---

<PageLayout
  title="Careers"
  description="Teaching and staff vacancies at Social Baluni Public School, Dehradun, and how to apply."
  breadcrumbs={[{ label: 'Careers', href: '/careers/' }]}
>
  <div class="grid gap-14 lg:grid-cols-[5fr_7fr]">
    <section aria-labelledby="openings-title">
      <h2 id="openings-title" class="text-3xl font-bold">Current openings</h2>
      {openJobs.length > 0 ? (
        <ul class="mt-6 border-t-2 border-ink" role="list">
          {openJobs.map((job) => (
            <li class="border-b border-paper-300 py-5">
              <h3 class="text-2xl font-bold">{job.title}</h3>
              <p class="mt-1 text-sm text-paper-600">{job.department} · {job.type}</p>
              <p class="mt-2 text-paper-800">{job.description}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="measure mt-4 text-lg text-paper-700">
          There are no advertised vacancies right now. You can still send your details with the form, and the school office will keep them on file.
        </p>
      )}
      <p class="mt-6 text-paper-700">
        Questions: <a href={school.phoneHref} class="font-semibold underline" data-figure>{school.phone}</a> or <a href={`mailto:${school.email}`} class="font-semibold underline">{school.email}</a>
      </p>
    </section>

    <section aria-labelledby="apply-title" class="border-t-2 border-ink pt-6">
      <h2 id="apply-title" class="text-3xl font-bold">Send your details</h2>
      <form method="POST" action="/api/careers" class="mt-6 grid gap-5 sm:grid-cols-2">
        <label class="sm:col-span-2">
          <span class="font-semibold">Full name</span>
          <input name="fullName" required autocomplete="name" class={field} />
        </label>
        <label>
          <span class="font-semibold">Email</span>
          <input name="email" type="email" required autocomplete="email" class={field} />
        </label>
        <label>
          <span class="font-semibold">Phone</span>
          <input name="phone" type="tel" required autocomplete="tel" inputmode="tel" class={field} />
        </label>
        <label class="sm:col-span-2">
          <span class="font-semibold">Position or subject</span>
          <input name="position" required class={field} placeholder="For example: TGT Mathematics" />
        </label>
        <label>
          <span class="font-semibold">Years of experience</span>
          <input name="experience" inputmode="numeric" class={field} />
        </label>
        <label>
          <span class="font-semibold">Qualifications</span>
          <input name="qualifications" class={field} />
        </label>
        <label class="sm:col-span-2">
          <span class="font-semibold">A short note <span class="font-normal text-paper-600">(optional)</span></span>
          <textarea name="coverNote" rows="5" maxlength="3000" class="mt-1 w-full border-2 border-paper-400 bg-white p-3 text-base focus:border-ink focus:outline-none"></textarea>
        </label>
        {turnstileKey && <div class="cf-turnstile sm:col-span-2" data-sitekey={turnstileKey}></div>}
        <button type="submit" class="h-12 bg-crimson-700 px-6 text-lg font-bold text-white hover:bg-crimson-800 sm:col-span-2 sm:justify-self-start">Send details</button>
      </form>
    </section>
  </div>
</PageLayout>
