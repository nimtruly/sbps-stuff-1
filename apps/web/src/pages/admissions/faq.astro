---
import PageLayout from '../../layouts/PageLayout.astro';
import { cms } from '../../lib/cms';
import { school } from '../../data/nav';

const faqs = await cms.getFAQs();
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
};
---

<PageLayout
  title="Admission questions"
  description="Answers to common questions about registration, the admission test, age criteria, documents and fees at SBPS."
  breadcrumbs={[{ label: 'Admissions', href: '/admissions/' }, { label: 'Questions', href: '/admissions/faq/' }]}
  schema={faqSchema}
>
  <div class="measure border-t-2 border-ink">
    {faqs.map((f) => (
      <details class="group border-b border-paper-300">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-xl font-semibold marker:hidden hover:text-crimson-700">
          {f.question}
          <svg class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.75" /></svg>
        </summary>
        <p class="pb-6 text-base text-paper-800">{f.answer}</p>
      </details>
    ))}
  </div>
  <p class="measure mt-10 text-paper-700">
    Another question? Call <a class="font-semibold underline" href={school.phoneHref} data-figure>{school.phone}</a> or <a class="font-semibold underline" href="/admissions/enquire/">send an enquiry</a>.
  </p>
</PageLayout>
