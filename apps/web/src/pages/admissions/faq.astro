---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Admissions', href: '/admissions/' },
  { label: 'Frequently Asked Questions', href: '/admissions/faq/' },
];

const faqs = await getCollection('faqs');

// Structured FAQPage JSON-LD
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.data.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.data.answer,
    },
  })),
};
---

<PageLayout
  title="Admissions FAQ"
  description="Frequently asked questions about admissions, fees, day boarding, integrated coaching, and transport at Social Baluni Public School, Dehradun."
  breadcrumbs={breadcrumbs}
>
  <!-- Inject FAQPage JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl">
    <div class="mb-10">
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-ink mb-4 tracking-tight">
        Frequently Asked Questions
      </h2>
      <p class="text-lg text-paper-700 leading-relaxed">
        Find clear answers to common questions regarding admissions, school timings, day boarding, integrated competitive coaching, transport, and fees at SBPS Dehradun.
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="space-y-6 mb-16">
      {faqs.map((faq, idx) => (
        <details class="group bg-paper-50 rounded-2xl border border-paper-200 p-6 open:bg-paper-100/60 open:border-crimson-200 transition-all shadow-2xs">
          <summary class="flex justify-between items-center font-serif text-lg sm:text-xl font-bold text-ink cursor-pointer list-none select-none">
            <span class="flex items-center gap-3">
              <span class="text-sm font-sans font-semibold text-crimson-700 bg-crimson-50 px-2 py-0.5 rounded border border-crimson-200">
                Q{idx + 1}
              </span>
              <span>{faq.data.question}</span>
            </span>
            <span class="text-xl text-crimson-700 transition-transform duration-200 group-open:rotate-180">
              ▼
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-paper-200 text-paper-700 leading-relaxed text-base">
            <p>{faq.data.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Still have questions card -->
    <div class="bg-paper-100 rounded-2xl p-8 border border-paper-300 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-xl font-serif font-bold text-ink mb-2">Have a question not answered here?</h2>
        <p class="text-sm text-paper-700">
          Our admissions counselling desk is ready to help you every Monday to Saturday, 8:30 AM to 3:30 PM.
        </p>
      </div>
      <div class="flex gap-3 shrink-0">
        <Button href="/admissions/enquire/" variant="primary" size="md">Enquire Online</Button>
        <Button href="/contact/" variant="outline" size="md">Contact Us</Button>
      </div>
    </div>
  </div>
</PageLayout>
