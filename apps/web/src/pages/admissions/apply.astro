---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Admissions', href: '/admissions/' },
  { label: 'Online Application', href: '/admissions/apply/' },
];

const grades = [
  'Nursery', 'LKG', 'UKG',
  'Class I', 'Class II', 'Class III', 'Class IV', 'Class V',
  'Class VI', 'Class VII', 'Class VIII',
  'Class IX', 'Class X',
  'Class XI (Medical / NEET Stream)',
  'Class XI (Non-Medical / JEE Stream)',
  'Class XI (Commerce Stream)',
  'Class XI (Humanities / Arts Stream)',
  'Class XI (Baluni Defence Academy Stream)',
  'Class XII'
];

const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<PageLayout
  title="Online Admission Application"
  description="Formal online admission application for Social Baluni Public School, Dehradun (Session 2027–28)."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl">
    <div class="mb-10">
      <span class="inline-block px-3 py-1 rounded-full bg-crimson-100 text-crimson-800 text-xs font-bold uppercase tracking-wider mb-2">
        Academic Session 2027–28
      </span>
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-ink mb-3 tracking-tight">
        Student Admission Registration Form
      </h2>
      <p class="text-base sm:text-lg text-paper-700 leading-relaxed">
        Please complete all fields carefully. Upon submission, an application reference number will be generated, and our admissions team will schedule the baseline interaction or entrance test.
      </p>
    </div>

    <form method="POST" action="/api/apply" class="space-y-12">
      <!-- Section 1: Student Information -->
      <fieldset class="bg-paper-50 rounded-2xl border border-paper-300 p-6 sm:p-8 shadow-xs">
        <legend class="px-3 text-lg font-serif font-bold text-ink">1. Student Details</legend>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 mt-4">
          <div class="md:col-span-2">
            <label for="studentName" class="block text-sm font-semibold text-ink mb-2">
              Full Name of Child (as per Birth Certificate) <span class="text-crimson-700">*</span>
            </label>
            <input
              type="text"
              id="studentName"
              name="studentName"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              placeholder="First Middle Last Name"
            />
          </div>

          <div>
            <label for="gender" class="block text-sm font-semibold text-ink mb-2">
              Gender <span class="text-crimson-700">*</span>
            </label>
            <select
              id="gender"
              name="gender"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
            >
              <option value="">Select Gender</option>
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div>
            <label for="dob" class="block text-sm font-semibold text-ink mb-2">
              Date of Birth <span class="text-crimson-700">*</span>
            </label>
            <input
              type="date"
              id="dob"
              name="dob"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
            />
          </div>

          <div>
            <label for="grade" class="block text-sm font-semibold text-ink mb-2">
              Class to which Admission is Sought <span class="text-crimson-700">*</span>
            </label>
            <select
              id="grade"
              name="grade"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
            >
              <option value="">Select Grade</option>
              {grades.map((g) => (
                <option value={g}>{g}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="aadhaarChild" class="block text-sm font-semibold text-ink mb-2">
              Aadhaar Card Number (Optional)
            </label>
            <input
              type="text"
              id="aadhaarChild"
              name="aadhaarChild"
              maxlength="12"
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              placeholder="12-digit Aadhaar"
            />
          </div>
        </div>
      </fieldset>

      <!-- Section 2: Previous School Record -->
      <fieldset class="bg-paper-50 rounded-2xl border border-paper-300 p-6 sm:p-8 shadow-xs">
        <legend class="px-3 text-lg font-serif font-bold text-ink">2. Previous Academic Record</legend>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 mt-4">
          <div class="sm:col-span-2">
            <label for="previousSchool" class="block text-sm font-semibold text-ink mb-2">
              Name of Previous School Attended
            </label>
            <input
              type="text"
              id="previousSchool"
              name="previousSchool"
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              placeholder="School Name, City"
            />
          </div>

          <div>
            <label for="previousBoard" class="block text-sm font-semibold text-ink mb-2">
              Previous Board
            </label>
            <select
              id="previousBoard"
              name="previousBoard"
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
            >
              <option value="CBSE">CBSE</option>
              <option value="ICSE/ISC">ICSE / ISC</option>
              <option value="State Board">Uttarakhand / State Board</option>
              <option value="Other">Other / None (Pre-primary)</option>
            </select>
          </div>

          <div>
            <label for="lastClassPercentage" class="block text-sm font-semibold text-ink mb-2">
              Last Class Marks / CGPA (%)
            </label>
            <input
              type="text"
              id="lastClassPercentage"
              name="lastClassPercentage"
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              placeholder="e.g. 88%"
            />
          </div>
        </div>
      </fieldset>

      <!-- Section 3: Parents Information -->
      <fieldset class="bg-paper-50 rounded-2xl border border-paper-300 p-6 sm:p-8 shadow-xs">
        <legend class="px-3 text-lg font-serif font-bold text-ink">3. Parent / Guardian Details</legend>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-4">
          <div>
            <label for="fatherName" class="block text-sm font-semibold text-ink mb-2">
              Father's Full Name <span class="text-crimson-700">*</span>
            </label>
            <input
              type="text"
              id="fatherName"
              name="fatherName"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              placeholder="Father's Name"
            />
          </div>

          <div>
            <label for="fatherOccupation" class="block text-sm font-semibold text-ink mb-2">
              Father's Occupation / Organisation
            </label>
            <input
              type="text"
              id="fatherOccupation"
              name="fatherOccupation"
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              placeholder="Profession / Designation"
            />
          </div>

          <div>
            <label for="motherName" class="block text-sm font-semibold text-ink mb-2">
              Mother's Full Name <span class="text-crimson-700">*</span>
            </label>
            <input
              type="text"
              id="motherName"
              name="motherName"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              placeholder="Mother's Name"
            />
          </div>

          <div>
            <label for="motherOccupation" class="block text-sm font-semibold text-ink mb-2">
              Mother's Occupation / Organisation
            </label>
            <input
              type="text"
              id="motherOccupation"
              name="motherOccupation"
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              placeholder="Profession / Designation / Homemaker"
            />
          </div>

          <div>
            <label for="mobile" class="block text-sm font-semibold text-ink mb-2">
              Primary Contact Mobile (WhatsApp) <span class="text-crimson-700">*</span>
            </label>
            <input
              type="tel"
              id="mobile"
              name="mobile"
              required
              pattern="[0-9]{10}"
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              placeholder="10-digit number"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-ink mb-2">
              Email Address <span class="text-crimson-700">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              placeholder="parent@example.com"
            />
          </div>

          <div class="sm:col-span-2">
            <label for="address" class="block text-sm font-semibold text-ink mb-2">
              Residential Address in Dehradun <span class="text-crimson-700">*</span>
            </label>
            <textarea
              id="address"
              name="address"
              required
              rows="3"
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              placeholder="House No., Street/Colony, Area/Locality, PIN Code"
            ></textarea>
          </div>
        </div>
      </fieldset>

      <!-- Declaration -->
      <div class="bg-paper-100 p-6 rounded-xl border border-paper-300 space-y-4">
        <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            name="declaration"
            required
            class="mt-1 h-4 w-4 rounded border-paper-400 text-crimson-700 focus:ring-crimson-500"
          />
          <span class="text-xs sm:text-sm text-paper-800 leading-relaxed">
            I hereby certify that the information furnished in this registration form is true and correct to the best of my knowledge. I understand that admission is subject to seat vacancy, document verification, and compliance with school rules.
          </span>
        </label>

        {turnstileKey && (
          <div class="cf-turnstile" data-sitekey={turnstileKey}></div>
        )}

        <div class="pt-2">
          <Button type="submit" variant="primary" size="lg">
            Submit Application Form →
          </Button>
        </div>
      </div>
    </form>
  </div>
</PageLayout>
