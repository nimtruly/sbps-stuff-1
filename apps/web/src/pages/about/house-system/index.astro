---
import PageLayout from '../../../layouts/PageLayout.astro';
import { cms } from '../../../lib/cms';

const houses = await cms.getHouses();
const breadcrumbs = [
  { name: 'About Us', href: '/about/' },
  { name: 'River House System', href: '/about/house-system/' },
];
---

<PageLayout
  title="The Himalayan River House System"
  description="Learn about the four river houses of Social Baluni Public School — Alaknanda, Bhilangna, Bhagirathi, and Mandakini — inspiring camaraderie, leadership, and healthy competition."
  breadcrumbs={breadcrumbs}
>
  <div class="space-y-16 max-w-5xl mx-auto">
    <!-- Introduction -->
    <div class="max-w-3xl space-y-4">
      <h2 class="font-serif text-3xl font-bold text-crimson-900 leading-tight">
        Rooted in the Sacred Waters of Uttarakhand
      </h2>
      <p class="text-sm sm:text-base text-paper-700 leading-relaxed">
        The house system at Social Baluni Public School is named in tribute to the four legendary Himalayan rivers that form the lifeblood of Uttarakhand and converge into Mother Ganga. Every student upon admission is inducted into one of these four houses, fostering lifelong bonds of camaraderie, team spirit, and ethical rivalry across academic, cultural, and sports competitions.
      </p>
    </div>

    <!-- 4 Houses Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {houses.map((h) => (
        <div class="p-8 rounded-2xl bg-paper-50 border border-paper-300 shadow-sm flex flex-col justify-between relative overflow-hidden">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-full flex items-center justify-center text-white font-bold text-xl shadow" style={`background-color: ${h.colorHex};`}>
                {h.name.charAt(0)}
              </div>
              <span class="text-xs font-bold px-2.5 py-1 rounded-full text-white tracking-wide" style={`background-color: ${h.colorHex};`}>
                {h.colorName}
              </span>
            </div>

            <div>
              <h3 class="font-serif text-2xl font-bold text-paper-900">
                {h.name}
              </h3>
              <div class="text-xs font-semibold text-paper-600 mt-0.5">
                Motto: <span class="italic text-paper-800">"{h.motto}"</span>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-paper-700 leading-relaxed">
              {h.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-paper-200 text-xs text-paper-600 font-medium">
            Origin: {h.river}
          </div>
        </div>
      ))}
    </div>

    <!-- House Activities & Scoring -->
    <section class="bg-paper-50 p-8 sm:p-12 rounded-2xl border border-paper-300 space-y-6">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-crimson-900">
        Inter-House Arenas & The Cock House Trophy
      </h2>
      <p class="text-sm text-paper-700 leading-relaxed">
        Throughout the academic year, the four houses contest fiercely but respectfully across multiple arenas to accumulate points toward the coveted annual <strong>Cock House Trophy</strong>, awarded during the Annual Sports Meet:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-2">
        <div class="space-y-2">
          <div class="font-serif font-bold text-base text-paper-900">Athletics & Sports</div>
          <p class="text-xs text-paper-600 leading-relaxed">
            Inter-house track & field tournaments, football league, cricket championship, table tennis, badminton, and martial arts showcases.
          </p>
        </div>

        <div class="space-y-2">
          <div class="font-serif font-bold text-base text-paper-900">Literary & Debates</div>
          <p class="text-xs text-paper-600 leading-relaxed">
            English and Hindi debates, elocution, quiz bowls, creative writing competitions, and model parliament assemblies.
          </p>
        </div>

        <div class="space-y-2">
          <div class="font-serif font-bold text-base text-paper-900">Arts & Science Exhibitions</div>
          <p class="text-xs text-paper-600 leading-relaxed">
            Rangoli and fine art displays, theatrical skits, folk dance recitals, robotics exhibits, and composite science projects.
          </p>
        </div>
      </div>
    </section>
  </div>
</PageLayout>
