---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/Button.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact Us', href: '/contact/' },
];

const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<PageLayout
  title="Contact Us & Campus Directions"
  description="Get in touch with Social Baluni Public School, Dehradun. Find campus location, phone numbers, email addresses, and visiting hours."
  breadcrumbs={breadcrumbs}
>
  <div class="mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-crimson-100 text-crimson-800 text-xs font-bold uppercase tracking-wider mb-4">
      Get In Touch
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-ink mb-4 tracking-tight">
      We’re Here to Help
    </h2>
    <p class="text-lg text-paper-700 max-w-3xl leading-relaxed">
      Whether you are exploring admissions for your child, inquiring about transport routes, or scheduling a personal campus tour, our administrative team is at your service.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-16">
    <!-- Contact Info & Map Details -->
    <div class="lg:col-span-5 space-y-8">
      <!-- Campus Address -->
      <div class="bg-paper-50 rounded-2xl p-6 border border-paper-200 shadow-2xs">
        <div class="flex items-start gap-4">
          <span class="text-2xl p-2.5 rounded-lg bg-crimson-100 text-crimson-800">📍</span>
          <div>
            <h2 class="text-lg font-serif font-bold text-ink mb-1">Campus Address</h2>
            <p class="text-sm text-paper-700 leading-relaxed">
              Social Baluni Public School<br />
              Haridwar Bypass Road, Brahmanwala,<br />
              Near Radhaswami Satsang Bhawan,<br />
              Dehradun, Uttarakhand — 248001
            </p>
          </div>
        </div>
      </div>

      <!-- Phone Numbers -->
      <div class="bg-paper-50 rounded-2xl p-6 border border-paper-200 shadow-2xs">
        <div class="flex items-start gap-4">
          <span class="text-2xl p-2.5 rounded-lg bg-crimson-100 text-crimson-800">📞</span>
          <div>
            <h2 class="text-lg font-serif font-bold text-ink mb-1">Telephone & WhatsApp</h2>
            <div class="space-y-1 text-sm text-paper-800 font-medium">
              <div>Admissions: <a href="tel:+919690000890" class="hover:text-crimson-700 font-bold">+91 96900 00890</a></div>
              <div>Administrative Office: <a href="tel:+919690000895" class="hover:text-crimson-700 font-bold">+91 96900 00895</a></div>
              <div>Helpdesk: <a href="tel:+919084717836" class="hover:text-crimson-700 font-bold">+91 90847 17836</a></div>
              <div class="pt-1">
                WhatsApp: <a href="https://wa.me/919690000890" target="_blank" rel="noopener noreferrer" class="text-forest-700 font-bold hover:underline">+91 96900 00890 ↗</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Office Hours & Emails -->
      <div class="bg-paper-50 rounded-2xl p-6 border border-paper-200 shadow-2xs">
        <div class="flex items-start gap-4">
          <span class="text-2xl p-2.5 rounded-lg bg-crimson-100 text-crimson-800">✉️</span>
          <div>
            <h2 class="text-lg font-serif font-bold text-ink mb-1">Email & Visiting Hours</h2>
            <div class="space-y-2 text-sm text-paper-700">
              <div>General: <a href="mailto:info@sbpsdoon.com" class="font-bold text-crimson-700">info@sbpsdoon.com</a></div>
              <div>Careers: <a href="mailto:careers@sbpsdoon.com" class="font-bold text-crimson-700">careers@sbpsdoon.com</a></div>
              <div class="pt-2 text-xs border-t border-paper-200">
                <strong>Office Visiting Hours:</strong><br />
                Monday – Saturday: 8:30 AM to 3:30 PM<br />
                (Closed on Sundays and Gazetted Holidays)
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Static Map Card (Zero-weight, links to Google Maps) -->
      <div class="rounded-2xl overflow-hidden border border-paper-300 bg-paper-100 shadow-xs">
        <div class="p-4 border-b border-paper-200 flex items-center justify-between">
          <span class="text-xs font-bold text-ink uppercase tracking-wider">Campus Location Map</span>
          <a
            href="https://maps.google.com/?q=Social+Baluni+Public+School+Dehradun"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold text-crimson-700 hover:underline"
          >
            Open in Google Maps ↗
          </a>
        </div>
        <a
          href="https://maps.google.com/?q=Social+Baluni+Public+School+Dehradun"
          target="_blank"
          rel="noopener noreferrer"
          class="block group relative overflow-hidden bg-paper-200 aspect-16/9"
        >
          <img
            src="/brand/DJI_20240917155020_0011_D-scaled.jpg"
            alt="Map and aerial view of Social Baluni Public School campus, Dehradun"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-ink/30 group-hover:bg-ink/20 transition-colors flex items-center justify-center">
            <span class="px-4 py-2 rounded-lg bg-white/95 text-ink font-bold text-xs shadow-md group-hover:scale-105 transition-transform">
              📍 Click to Navigate via Google Maps
            </span>
          </div>
        </a>
      </div>
    </div>

    <!-- Contact Enquiry Form -->
    <div class="lg:col-span-7">
      <div class="bg-paper-50 rounded-2xl border border-paper-300 p-6 sm:p-10 shadow-sm">
        <h2 class="text-2xl font-serif font-bold text-ink mb-2">Send Us a Direct Message</h2>
        <p class="text-sm text-paper-700 mb-8">
          Fill out the form below and our administrative office will respond within 24 working hours.
        </p>

        <form method="POST" action="/api/enquiry" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="contactName" class="block text-sm font-semibold text-ink mb-2">
                Your Full Name <span class="text-crimson-700">*</span>
              </label>
              <input
                type="text"
                id="contactName"
                name="parentName"
                required
                class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
                placeholder="Name"
              />
            </div>

            <div>
              <label for="contactPhone" class="block text-sm font-semibold text-ink mb-2">
                Mobile Number <span class="text-crimson-700">*</span>
              </label>
              <input
                type="tel"
                id="contactPhone"
                name="phone"
                required
                pattern="[0-9]{10}"
                class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
                placeholder="10-digit number"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="contactEmail" class="block text-sm font-semibold text-ink mb-2">
                Email Address <span class="text-crimson-700">*</span>
              </label>
              <input
                type="email"
                id="contactEmail"
                name="email"
                required
                class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
                placeholder="name@example.com"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-semibold text-ink mb-2">
                Nature of Inquiry
              </label>
              <select
                id="subject"
                name="grade"
                class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              >
                <option value="General Inquiry">General School Inquiry</option>
                <option value="Admission Inquiry">Admissions 2027–28</option>
                <option value="Day Boarding Inquiry">Day Boarding & Transport</option>
                <option value="Integrated Coaching">Integrated NEET/JEE/NDA Coaching</option>
                <option value="Accounts & Fees">Accounts & Fee Receipts</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-ink mb-2">
              Your Message <span class="text-crimson-700">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full px-4 py-2.5 rounded-lg border border-paper-300 bg-white text-ink focus:border-crimson-600 focus:ring-2 focus:ring-crimson-200 outline-none text-sm"
              placeholder="How can we assist you?"
            ></textarea>
          </div>

          {turnstileKey && (
            <div class="cf-turnstile" data-sitekey={turnstileKey}></div>
          )}

          <div>
            <Button type="submit" variant="primary" size="lg" class="w-full sm:w-auto">
              Send Message →
            </Button>
          </div>
        </form>
      </div>
    </div>
  </div>
</PageLayout>
