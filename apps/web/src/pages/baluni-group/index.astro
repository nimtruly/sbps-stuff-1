---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Baluni Group of Institutions', href: '/baluni-group/' },
];

const institutions = await getCollection('institutions');
---

<PageLayout
  title="Baluni Group of Educational Institutions"
  description="Discover the educational legacy of Baluni Group: premier coaching institutes, defence academies, and CBSE public schools across Uttarakhand and Uttar Pradesh."
  breadcrumbs={breadcrumbs}
>
  <div class="mb-14">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-crimson-100 text-crimson-800 text-xs font-bold uppercase tracking-wider mb-4">
      Educational Legacy Since 1999
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-ink mb-4 tracking-tight">
      The Baluni Group of Educational Institutions
    </h2>
    <p class="text-lg text-paper-700 max-w-3xl leading-relaxed">
      Founded by visionary educationist Dr. Navin Baluni, the Baluni Group has shaped the aspirations of tens of thousands of doctors, engineers, armed forces officers, and leaders across North India. Social Baluni Public School in Dehradun represents the fruition of this educational ecosystem.
    </p>
  </div>

  <!-- Dr. Navin Baluni Vision Card -->
  <section class="bg-paper-100 rounded-2xl p-6 sm:p-10 border border-paper-300 mb-16 shadow-xs">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-8 space-y-4">
        <span class="text-xs font-bold text-saffron-800 bg-saffron-100 px-3 py-1 rounded-full uppercase tracking-wider border border-saffron-200">
          The Founder's Vision
        </span>
        <h2 class="text-2xl font-serif font-bold text-ink">
          Empowering Youth through Accessible Academic Excellence
        </h2>
        <p class="text-sm sm:text-base text-paper-700 leading-relaxed">
          "Our mission has always been singular: to remove the disparity in educational opportunities between metropolitan centres and tier-2/3 cities. By establishing world-class coaching institutes and high-standard CBSE schools in Uttarakhand and Uttar Pradesh, we ensure that talented students can achieve their highest potential right here in their home state."
        </p>
        <p class="text-sm font-bold text-crimson-800">
          — Dr. Navin Baluni, Founder & Chairman, Baluni Group
        </p>
      </div>

      <div class="lg:col-span-4 bg-paper-50 rounded-xl p-5 border border-paper-200 text-center">
        <div class="text-3xl font-serif font-bold text-crimson-800 mb-1">25+ Years</div>
        <div class="text-xs text-paper-600 mb-4">Pioneering Education & Coaching</div>
        <div class="text-2xl font-serif font-bold text-forest-700 mb-1">Thousands</div>
        <div class="text-xs text-paper-600 mb-4">Doctors, IITians & Officers Produced</div>
        <div class="text-2xl font-serif font-bold text-ink mb-1">6+ Campuses</div>
        <div class="text-xs text-paper-600">Across Dehradun, Kotdwar & Agra</div>
      </div>
    </div>
  </section>

  <!-- Sister Institutions Grid -->
  <section class="mb-16">
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-serif font-bold text-ink mb-2">Our Sister Institutions</h2>
      <p class="text-paper-700 text-sm sm:text-base">
        The sister campuses and specialized academies under the Baluni umbrella that power our integrated curricula and mentorship.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {institutions.map((inst) => (
        <div class="p-6 rounded-2xl bg-paper-50 border border-paper-200 shadow-2xs hover:border-crimson-300 transition-colors flex flex-col justify-between">
          <div>
            <span class="inline-block px-2.5 py-0.5 rounded bg-crimson-50 text-crimson-800 text-xs font-bold uppercase tracking-wider mb-2 border border-crimson-200">
              {inst.data.type}
            </span>
            <h3 class="text-xl font-serif font-bold text-ink mb-3">{inst.data.name}</h3>
            
            <p class="text-xs sm:text-sm text-paper-700 mb-4 leading-relaxed">
              <strong>Address:</strong> {inst.data.address}
            </p>

            <div class="space-y-1 text-xs text-paper-600 mb-6">
              <div>
                <strong>Phone:</strong> {inst.data.phones.join(' / ')}
              </div>
              <div>
                <strong>Email:</strong> {inst.data.email}
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-paper-200">
            <a
              href={inst.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-crimson-700 hover:text-crimson-900 transition-colors"
            >
              <span>Visit Official Website</span>
              <span class="text-2xs">↗</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-crimson-800 text-white rounded-2xl p-8 sm:p-10 text-center shadow-md">
    <h2 class="text-2xl sm:text-3xl font-serif font-bold mb-3 text-white">Experience the Baluni Academic Advantage</h2>
    <p class="text-crimson-100 max-w-xl mx-auto mb-6 text-sm sm:text-base">
      Enquire now to enrol your ward in our CBSE curriculum with integrated NEET, JEE, and NDA coaching.
    </p>
    <Button href="/admissions/enquire/" variant="secondary" size="lg">Enquire for Admissions</Button>
  </section>
</PageLayout>
