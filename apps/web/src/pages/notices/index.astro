---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/Button.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Notices & Circulars', href: '/notices/' },
];

const allNotices = await getCollection('notices');
const now = new Date();

// Filter expired
const activeNotices = allNotices.filter((n) => {
  if (n.data.expiresAt) {
    return new Date(n.data.expiresAt) >= now;
  }
  return true;
});

// Sort pinned first, then date descending
const sortedNotices = activeNotices.sort((a, b) => {
  if (a.data.pinned && !b.data.pinned) return -1;
  if (!a.data.pinned && b.data.pinned) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const categories = ['All', 'Admissions', 'Exams', 'Holidays', 'Events', 'General'];
---

<PageLayout
  title="Notices & Circulars"
  description="Official notices, academic circulars, holiday announcements, and examination dates from Social Baluni Public School, Dehradun."
  breadcrumbs={breadcrumbs}
>
  <div class="mb-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-ink mb-2 tracking-tight">
        Notices & Circulars
      </h2>
      <p class="text-base text-paper-700">
        Stay updated with official notifications, holiday schedules, examination notices, and school circulars.
      </p>
    </div>
    <div class="shrink-0 flex gap-2">
      <a
        href="/notices/rss.xml"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-paper-300 text-xs font-semibold text-paper-700 hover:text-crimson-800 bg-paper-50 hover:bg-paper-100 transition-colors"
        title="Subscribe to Notices RSS Feed"
      >
        <span>📡</span> RSS Feed
      </a>
    </div>
  </div>

  <!-- Notices List -->
  <section class="space-y-4 mb-16">
    {sortedNotices.map((notice) => (
      <article
        class={`p-6 rounded-2xl border transition-all ${
          notice.data.pinned
            ? 'bg-saffron-50/50 border-saffron-300 shadow-xs'
            : 'bg-paper-50 border-paper-200 hover:border-crimson-300'
        }`}
      >
        <div class="flex flex-wrap items-center gap-3 mb-3">
          {notice.data.pinned && (
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-saffron-200 text-saffron-900 text-xs font-bold uppercase tracking-wider">
              📌 Pinned
            </span>
          )}
          <span class="px-2.5 py-0.5 rounded-full bg-crimson-100 text-crimson-800 text-xs font-bold uppercase tracking-wider">
            {notice.data.category}
          </span>
          <time datetime={notice.data.date} class="text-xs text-paper-500 font-medium">
            {new Date(notice.data.date).toLocaleDateString('en-IN', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </div>

        <h2 class="text-xl font-serif font-bold text-ink mb-3">
          <a
            href={`/notices/${notice.data.id}/`}
            class="hover:text-crimson-700 transition-colors"
          >
            {notice.data.title}
          </a>
        </h2>

        <p class="text-sm text-paper-700 line-clamp-3 mb-4 leading-relaxed whitespace-pre-line">
          {notice.data.body}
        </p>

        <div class="flex flex-wrap items-center justify-between gap-4 pt-3 border-t border-paper-200/80">
          <a
            href={`/notices/${notice.data.id}/`}
            class="text-xs font-bold text-crimson-700 hover:text-crimson-900 inline-flex items-center gap-1"
          >
            Read Full Notice →
          </a>

          {notice.data.attachments && notice.data.attachments.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {notice.data.attachments.map((att) => (
                <a
                  href={att.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-paper-100 hover:bg-paper-200 text-ink text-xs font-medium border border-paper-300 transition-colors"
                >
                  <span>📎</span>
                  <span>{att.title}</span>
                  <span class="text-2xs text-paper-500">PDF</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </section>
</PageLayout>
