---
import PageLayout from '../../layouts/PageLayout.astro';
import { cms } from '../../lib/cms';
import { withNoticeRefs, formatDate } from '../../lib/refs';

const notices = withNoticeRefs(await cms.getNotices());
---

<PageLayout
  title="Notices"
  description="Circulars and announcements from Social Baluni Public School. Quote the reference number when you call the school about a notice."
  breadcrumbs={[{ label: 'Parents', href: '/parents/' }, { label: 'Notices', href: '/notices/' }]}
>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <p class="text-paper-700">Newest first.</p>
    <a href="/notices/rss.xml" class="text-sm font-semibold underline">RSS feed</a>
  </div>

  {notices.length > 0 ? (
    <ol class="mt-6 border-t-2 border-ink" role="list">
      {notices.map((n) => (
        <li class="border-b border-paper-300">
          <a href={`/notices/${n.id}/`} class="group grid gap-2 py-5 sm:grid-cols-[9rem_1fr] sm:gap-8">
            <span class="text-sm text-paper-600">
              <time datetime={n.date}>{formatDate(n.date)}</time>
              <span class="block font-semibold text-ink" data-figure>{n.ref}</span>
            </span>
            <span>
              <span class="block text-xl font-semibold group-hover:text-crimson-700 group-hover:underline">{n.title}</span>
              <span class="mt-1 block text-sm text-paper-600">{n.category}{n.pinned ? ' · Pinned' : ''}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <p class="mt-8 text-lg text-paper-700">There are no notices right now.</p>
  )}
</PageLayout>
