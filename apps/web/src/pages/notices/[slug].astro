---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const notices = await getCollection('notices');
  return notices.map((notice) => ({
    params: { slug: notice.data.id },
    props: { notice },
  }));
}

const { notice } = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Notices', href: '/notices/' },
  { label: notice.data.title, href: `/notices/${notice.data.id}/` },
];

// If it's an event notice, provide Event JSON-LD
const eventSchema = notice.data.category === 'Events' ? {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: notice.data.title,
  startDate: notice.data.date,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Social Baluni Public School Campus',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Bypass Road, Near Kargi Chowk',
      addressLocality: 'Dehradun',
      addressRegion: 'Uttarakhand',
      postalCode: '248001',
      addressCountry: 'IN',
    },
  },
  description: notice.data.body.slice(0, 150),
} : null;
---

<PageLayout
  title={notice.data.title}
  description={notice.data.body.slice(0, 150)}
  breadcrumbs={breadcrumbs}
>
  {eventSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  )}

  <article class="max-w-3xl">
    <div class="mb-8">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        {notice.data.pinned && (
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-saffron-200 text-saffron-900 text-xs font-bold uppercase tracking-wider">
            📌 Pinned Circular
          </span>
        )}
        <span class="px-2.5 py-0.5 rounded-full bg-crimson-100 text-crimson-800 text-xs font-bold uppercase tracking-wider">
          {notice.data.category}
        </span>
        <time datetime={notice.data.date} class="text-xs text-paper-500 font-medium">
          Date of Issue: {new Date(notice.data.date).toLocaleDateString('en-IN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </div>

      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-ink mb-4 tracking-tight leading-tight">
        {notice.data.title}
      </h2>
    </div>

    <!-- Notice Body -->
    <div class="bg-paper-50 rounded-2xl p-6 sm:p-8 border border-paper-200 text-paper-800 leading-relaxed text-base sm:text-lg mb-8 shadow-xs whitespace-pre-line">
      {notice.data.body}
    </div>

    <!-- Attachments (PDFs) -->
    {notice.data.attachments && notice.data.attachments.length > 0 && (
      <div class="bg-paper-100 rounded-xl p-6 border border-paper-300 mb-10">
        <h2 class="text-sm font-bold text-ink uppercase tracking-wider mb-3">Official Attachments & Circulars</h2>
        <div class="space-y-2">
          {notice.data.attachments.map((att) => (
            <a
              href={att.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-3 rounded-lg bg-white border border-paper-200 hover:border-crimson-300 transition-colors group"
            >
              <div class="flex items-center gap-3">
                <span class="text-xl">📄</span>
                <div>
                  <div class="text-sm font-bold text-ink group-hover:text-crimson-700 transition-colors">
                    {att.title}
                  </div>
                  <div class="text-xs text-paper-500">Official Signed Document (PDF)</div>
                </div>
              </div>
              <span class="text-xs font-semibold text-crimson-700 px-3 py-1 bg-crimson-50 rounded group-hover:bg-crimson-100 transition-colors">
                Download PDF ↗
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="border-t border-paper-200 pt-6 flex justify-between items-center text-sm">
      <a href="/notices/" class="font-semibold text-crimson-700 hover:text-crimson-900 inline-flex items-center gap-1">
        ← Back to all notices & circulars
      </a>
      <a href="/admissions/enquire/" class="font-semibold text-forest-700 hover:text-forest-900">
        Admission Enquiry →
      </a>
    </div>
  </article>
</PageLayout>
