---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Mandatory Public Disclosure', href: '/disclosure/' },
];

const allDocs = await getCollection('disclosureDocs');

// Group docs by Appendix-IX categories
const generalInfo = allDocs.filter((d) => d.data.group === 'General Information');
const documentsInfo = allDocs.filter((d) => d.data.group === 'Documents and Information');
const resultsAcademics = allDocs.filter((d) => d.data.group === 'Results and Academics');
const staffInfo = allDocs.filter((d) => d.data.group === 'Staff (Teaching)');
const infraInfo = allDocs.filter((d) => d.data.group === 'School Infrastructure');

const now = new Date();

function checkExpiry(validTo?: string) {
  if (!validTo) return { isExpired: false, label: '' };
  const expiryDate = new Date(validTo);
  const isExpired = expiryDate < now;
  return {
    isExpired,
    label: isExpired
      ? `Renewal in process (Valid till ${expiryDate.toLocaleDateString('en-IN')})`
      : `Valid till ${expiryDate.toLocaleDateString('en-IN')}`,
  };
}
---

<PageLayout
  title="CBSE Mandatory Public Disclosure (Appendix-IX)"
  description="Official Mandatory Public Disclosure under Appendix-IX of CBSE Affiliation Bye-Laws for Social Baluni Public School, Dehradun (Affiliation No. 3530479, School Code 81702)."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-5xl">
    <div class="mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-3 py-1 rounded-full bg-crimson-100 text-crimson-800 text-xs font-bold uppercase tracking-wider">
          CBSE Affiliation: 3530479
        </span>
        <span class="px-3 py-1 rounded-full bg-paper-200 text-ink text-xs font-bold uppercase tracking-wider">
          School Code: 81702
        </span>
      </div>
      <p class="text-base sm:text-lg text-paper-700 leading-relaxed">
        In strict compliance with <strong>Appendix-IX</strong> of the Affiliation Bye-Laws issued by the Central Board of Secondary Education (CBSE), New Delhi, Social Baluni Public School publishes the complete statutory documentation, safety certificates, academic performance, and infrastructural details below.
      </p>
    </div>

    <!-- Section A: General Information -->
    <section class="mb-14 bg-paper-50 rounded-2xl border border-paper-300 overflow-hidden shadow-xs">
      <div class="bg-paper-200/70 px-6 py-4 border-b border-paper-300 flex items-center justify-between">
        <h2 class="text-lg sm:text-xl font-serif font-bold text-ink">
          A. General Information
        </h2>
        <span class="text-xs font-bold text-paper-600 uppercase tracking-wider">Part 1</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <tbody class="divide-y divide-paper-200">
            {generalInfo.map((item, idx) => (
              <tr class="hover:bg-paper-100/50">
                <td class="p-4 font-mono text-xs text-paper-500 w-12">{idx + 1}</td>
                <td class="p-4 font-bold text-ink w-1/3">{item.data.title}</td>
                <td class="p-4 text-paper-800">{item.data.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section B: Documents and Information -->
    <section class="mb-14 bg-paper-50 rounded-2xl border border-paper-300 overflow-hidden shadow-xs">
      <div class="bg-paper-200/70 px-6 py-4 border-b border-paper-300 flex items-center justify-between">
        <h2 class="text-lg sm:text-xl font-serif font-bold text-ink">
          B. Documents and Information
        </h2>
        <span class="text-xs font-bold text-paper-600 uppercase tracking-wider">Part 2</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-paper-100/80 text-xs font-bold uppercase tracking-wider text-paper-600 border-b border-paper-200">
              <th class="p-4 w-12">S.No.</th>
              <th class="p-4">Documents / Information</th>
              <th class="p-4 w-48 text-right">Upload Document (PDF)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-paper-200">
            {documentsInfo.map((item, idx) => {
              const expiry = checkExpiry(item.data.validTo);
              return (
                <tr class="hover:bg-paper-100/50">
                  <td class="p-4 font-mono text-xs text-paper-500">{idx + 1}</td>
                  <td class="p-4">
                    <div class="font-bold text-ink mb-1">{item.data.title}</div>
                    {expiry.isExpired && (
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-2xs font-bold bg-amber-100 text-amber-900 border border-amber-300">
                        <span>⚠️</span> {expiry.label}
                      </span>
                    )}
                  </td>
                  <td class="p-4 text-right">
                    {item.data.fileUrl ? (
                      <a
                        href={item.data.fileUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-crimson-50 text-crimson-800 hover:bg-crimson-100 font-semibold text-xs border border-crimson-200 transition-colors"
                      >
                        <span>View PDF</span>
                        <span class="text-2xs">↗</span>
                      </a>
                    ) : (
                      <span class="text-xs text-paper-400">Not Applicable</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section C: Results and Academics -->
    <section class="mb-14 bg-paper-50 rounded-2xl border border-paper-300 overflow-hidden shadow-xs">
      <div class="bg-paper-200/70 px-6 py-4 border-b border-paper-300 flex items-center justify-between">
        <h2 class="text-lg sm:text-xl font-serif font-bold text-ink">
          C. Results and Academics
        </h2>
        <span class="text-xs font-bold text-paper-600 uppercase tracking-wider">Part 3</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-paper-100/80 text-xs font-bold uppercase tracking-wider text-paper-600 border-b border-paper-200">
              <th class="p-4 w-12">S.No.</th>
              <th class="p-4">Statutory Document / Record</th>
              <th class="p-4 w-48 text-right">Upload Document (PDF)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-paper-200">
            {resultsAcademics.map((item, idx) => (
              <tr class="hover:bg-paper-100/50">
                <td class="p-4 font-mono text-xs text-paper-500">{idx + 1}</td>
                <td class="p-4 font-bold text-ink">{item.data.title}</td>
                <td class="p-4 text-right">
                  {item.data.fileUrl ? (
                    <a
                      href={item.data.fileUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-crimson-50 text-crimson-800 hover:bg-crimson-100 font-semibold text-xs border border-crimson-200 transition-colors"
                    >
                      <span>View PDF</span>
                      <span class="text-2xs">↗</span>
                    </a>
                  ) : (
                    <span class="text-xs text-paper-400">Available on Request</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section D: Staff (Teaching) -->
    <section class="mb-14 bg-paper-50 rounded-2xl border border-paper-300 overflow-hidden shadow-xs">
      <div class="bg-paper-200/70 px-6 py-4 border-b border-paper-300 flex items-center justify-between">
        <h2 class="text-lg sm:text-xl font-serif font-bold text-ink">
          D. Staff (Teaching)
        </h2>
        <span class="text-xs font-bold text-paper-600 uppercase tracking-wider">Part 4</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <tbody class="divide-y divide-paper-200">
            {staffInfo.map((item, idx) => (
              <tr class="hover:bg-paper-100/50">
                <td class="p-4 font-mono text-xs text-paper-500 w-12">{idx + 1}</td>
                <td class="p-4 font-bold text-ink w-1/3">{item.data.title}</td>
                <td class="p-4 text-paper-800">{item.data.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section E: School Infrastructure -->
    <section class="mb-16 bg-paper-50 rounded-2xl border border-paper-300 overflow-hidden shadow-xs">
      <div class="bg-paper-200/70 px-6 py-4 border-b border-paper-300 flex items-center justify-between">
        <h2 class="text-lg sm:text-xl font-serif font-bold text-ink">
          E. School Infrastructure
        </h2>
        <span class="text-xs font-bold text-paper-600 uppercase tracking-wider">Part 5</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <tbody class="divide-y divide-paper-200">
            {infraInfo.map((item, idx) => (
              <tr class="hover:bg-paper-100/50">
                <td class="p-4 font-mono text-xs text-paper-500 w-12">{idx + 1}</td>
                <td class="p-4 font-bold text-ink w-1/3">{item.data.title}</td>
                <td class="p-4 text-paper-800">
                  {item.data.value?.startsWith('http') ? (
                    <a
                      href={item.data.value}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-crimson-700 underline font-semibold hover:text-crimson-900"
                    >
                      {item.data.value} ↗
                    </a>
                  ) : (
                    item.data.value
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Statutory Certification Footnote -->
    <div class="bg-paper-100 rounded-2xl p-6 border border-paper-300 text-xs text-paper-700 leading-relaxed mb-12">
      <p class="font-bold text-ink mb-1">Official Declaration by the Principal / Manager:</p>
      <p>
        I hereby confirm that the information and documents uploaded under Appendix-IX Mandatory Public Disclosure are true and authentic copies of the original records maintained by Social Baluni Public School and approved by the School Management Committee (SMC).
      </p>
    </div>
  </div>
</PageLayout>
