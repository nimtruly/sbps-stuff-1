---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  excerpt?: string;
  category: string;
  categoryHref?: string;
  publishedAt: string;
  author?: string;
  coverImage?: string;
  tags?: string[];
  slug: string;
}

const {
  title,
  excerpt,
  category,
  categoryHref = `/blog/category/${category.toLowerCase().replace(/\s+/g, '-')}/`,
  publishedAt,
  author = 'SBPS Editorial Desk',
  coverImage,
  tags = [],
  slug,
} = Astro.props;

const dateFormatted = new Date(publishedAt).toLocaleDateString('en-IN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description: excerpt,
  image: coverImage ? [`https://www.sbpsdoon.com${coverImage}`] : undefined,
  datePublished: publishedAt,
  dateModified: publishedAt,
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'School',
    name: 'Social Baluni Public School',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.sbpsdoon.com/brand/sbps-logo.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://www.sbpsdoon.com/blog/${slug}/`,
  },
};
---

<BaseLayout title={`${title} | SBPS Dehradun`} description={excerpt} ogImage={coverImage} schema={articleSchema}>
  <article class="py-10 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-paper-600 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-crimson-700 transition-colors">Home</a>
        <span class="text-paper-400" aria-hidden="true">/</span>
        <a href="/blog/" class="hover:text-crimson-700 transition-colors">Blog</a>
        <span class="text-paper-400" aria-hidden="true">/</span>
        <a href={categoryHref} class="hover:text-crimson-700 transition-colors">{category}</a>
      </nav>

      <!-- Category & Meta -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <a
          href={categoryHref}
          class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-crimson-50 text-crimson-800 hover:bg-crimson-100 transition-colors"
        >
          {category}
        </a>
        <span class="text-xs text-paper-500">•</span>
        <time datetime={publishedAt} class="text-xs text-paper-600 tabular-nums">
          {dateFormatted}
        </time>
        <span class="text-xs text-paper-500">•</span>
        <span class="text-xs text-paper-600 font-medium">By {author}</span>
      </div>

      <!-- One H1 -->
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-crimson-950 tracking-tight leading-tight mb-6">
        {title}
      </h1>

      {excerpt && (
        <p class="text-lg sm:text-xl text-paper-700 font-normal leading-relaxed mb-8 border-l-4 border-crimson-700 pl-4 py-1 italic bg-paper-50">
          {excerpt}
        </p>
      )}

      {coverImage && (
        <div class="mb-10 rounded-xl overflow-hidden shadow-md">
          <img
            src={coverImage}
            alt={title}
            class="w-full h-auto object-cover max-h-[480px]"
            loading="eager"
          />
        </div>
      )}

      <!-- Body Article with strict measure 65-75ch -->
      <div class="prose prose-lg max-w-[70ch] mx-auto text-paper-800 leading-relaxed space-y-6">
        <slot />
      </div>

      <!-- Tags & Share Footer -->
      {tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-paper-300 max-w-[70ch] mx-auto">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold text-paper-600">Tags:</span>
            {tags.map((tag) => (
              <span class="inline-block px-2.5 py-1 text-xs bg-paper-200 text-paper-800 rounded">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</BaseLayout>
