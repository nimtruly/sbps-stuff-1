---
import BaseLayout from './BaseLayout.astro';

interface BreadcrumbItem {
  name?: string;
  label?: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: BreadcrumbItem[];
  ogImage?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const { title, description, breadcrumbs = [], ogImage, schema, noindex = false } = Astro.props;

// Build BreadcrumbList JSON-LD
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://www.sbpsdoon.com/',
    },
    ...breadcrumbs.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 2,
      name: b.name || b.label || '',
      item: `https://www.sbpsdoon.com${b.href}`,
    })),
  ],
} : null;

const combinedSchemas = [
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
---

<BaseLayout title={`${title} | Social Baluni Public School, Dehradun`} description={description} ogImage={ogImage} schema={combinedSchemas} noindex={noindex}>
  <!-- Page Header Banner -->
  <section class="bg-gradient-to-b from-paper-200/80 to-paper-100 border-b border-paper-300 py-10 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {breadcrumbs.length > 0 && (
        <nav class="flex items-center gap-2 text-xs text-paper-600 mb-3" aria-label="Breadcrumb">
          <a href="/" class="hover:text-crimson-700 transition-colors">Home</a>
          {breadcrumbs.map((b, idx) => (
            <>
              <span class="text-paper-400" aria-hidden="true">/</span>
              {idx === breadcrumbs.length - 1 ? (
                <span class="text-paper-900 font-semibold" aria-current="page">{b.name || b.label}</span>
              ) : (
                <a href={b.href} class="hover:text-crimson-700 transition-colors">{b.name || b.label}</a>
              )}
            </>
          ))}
        </nav>
      )}

      <!-- One H1 per page -->
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-crimson-900 tracking-tight leading-tight">
        {title}
      </h1>
      {description && (
        <p class="mt-3 text-base sm:text-lg text-paper-700 max-w-3xl leading-relaxed">
          {description}
        </p>
      )}
    </div>
  </section>

  <!-- Content Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <slot />
  </div>
</BaseLayout>
