{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "wrangler pages dev dist --port 4321",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.2.0",
    "@astrojs/preact": "^4.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/anek-devanagari": "5.3.0",
    "@fontsource-variable/anek-latin": "5.3.0",
    "@sanity/client": "^6.27.2",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.3.0",
    "drizzle-orm": "^0.39.0",
    "preact": "^10.25.4",
    "preact-render-to-string": "^6.5.13",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.13.1",
    "drizzle-kit": "^0.30.4",
    "pagefind": "^1.3.0",
    "vitest": "^3.0.5",
    "wrangler": "^3.107.3"
  }
}
