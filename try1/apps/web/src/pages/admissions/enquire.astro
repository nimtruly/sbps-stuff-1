---
import PageLayout from '../../layouts/PageLayout.astro';
import { school } from '../../data/nav';

const classes = ['Nursery', 'LKG', 'UKG', 'Class I', 'Class II', 'Class III', 'Class IV', 'Class V', 'Class VI', 'Class VII', 'Class VIII', 'Class IX', 'Class X', 'Class XI', 'Class XII'];
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const field = 'mt-1 h-12 w-full border-2 border-paper-400 bg-white px-3 text-base focus:border-ink focus:outline-none';
---

<PageLayout
  title="Admission enquiry"
  description="Ask about admission, day boarding or the integrated programmes, or ask to visit the school. The admissions office will contact you."
  breadcrumbs={[{ label: 'Admissions', href: '/admissions/' }, { label: 'Enquire', href: '/admissions/enquire/' }]}
>
  <div class="grid gap-14 lg:grid-cols-[7fr_5fr]">
    <form method="POST" action="/api/enquiry" class="grid gap-5 sm:grid-cols-2" aria-label="Admission enquiry">
      <label>
        <span class="font-semibold">Parent's name</span>
        <input name="parentName" required autocomplete="name" class={field} />
      </label>
      <label>
        <span class="font-semibold">Child's name <span class="font-normal text-paper-600">(optional)</span></span>
        <input name="studentName" class={field} />
      </label>
      <label>
        <span class="font-semibold">Phone</span>
        <input name="phone" type="tel" required inputmode="tel" autocomplete="tel" class={field} />
      </label>
      <label>
        <span class="font-semibold">Email <span class="font-normal text-paper-600">(optional)</span></span>
        <input name="email" type="email" autocomplete="email" class={field} />
      </label>
      <label>
        <span class="font-semibold">Class applying for</span>
        <select name="grade" required class={field}>
          <option value="">Choose a class</option>
          {classes.map((c) => <option>{c}</option>)}
        </select>
      </label>
      <label>
        <span class="font-semibold">How should we contact you?</span>
        <select name="preferredContact" class={field}>
          <option value="phone">Phone call</option>
          <option value="whatsapp">WhatsApp</option>
          <option value="email">Email</option>
        </select>
      </label>
      <label class="sm:col-span-2">
        <span class="font-semibold">Questions or a preferred visit day <span class="font-normal text-paper-600">(optional)</span></span>
        <textarea name="message" rows="4" maxlength="2000" class="mt-1 w-full border-2 border-paper-400 bg-white p-3 text-base focus:border-ink focus:outline-none"></textarea>
      </label>
      {turnstileKey && <div class="cf-turnstile sm:col-span-2" data-sitekey={turnstileKey}></div>}
      <button type="submit" class="h-12 bg-saffron-500 px-6 text-lg font-bold text-ink hover:bg-saffron-400 sm:col-span-2 sm:justify-self-start">Send enquiry</button>
    </form>

    <aside class="border-t-2 border-ink pt-5" aria-labelledby="other-ways">
      <h2 id="other-ways" class="text-2xl font-bold">Prefer to talk?</h2>
      <ul class="mt-4 space-y-2 text-lg" role="list">
        {school.phones.map((p) => <li><a class="font-semibold hover:text-crimson-700 hover:underline" href={`tel:${p.replace(/\s/g, '')}`} data-figure>{p}</a></li>)}
        <li><a class="font-semibold hover:text-crimson-700 hover:underline" href={school.whatsapp} rel="noopener">WhatsApp</a></li>
      </ul>
      <p class="mt-6 text-paper-700">Registration runs from the last week of December to the last week of February. <a href="/admissions/" class="font-semibold text-crimson-700 underline">How admission works</a></p>
    </aside>
  </div>
</PageLayout>
