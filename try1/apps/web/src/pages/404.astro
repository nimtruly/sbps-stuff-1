---
import PageLayout from '../layouts/PageLayout.astro';

const links: [string, string][] = [
  ['How admission works', '/admissions/'],
  ['Fees', '/admissions/fees/'],
  ['Notices', '/notices/'],
  ['Integrated programmes', '/academics/integrated-programme/'],
  ['CBSE disclosure', '/disclosure/'],
  ['Contact', '/contact/'],
];
---

<PageLayout
  title="Page not found"
  description="This page does not exist or has moved. If you followed a link from the old school website, try searching."
  noindex
>
  <form action="/search/" method="get" role="search" class="measure flex gap-2">
    <label for="q404" class="sr-only">Search the site</label>
    <input id="q404" name="q" type="search" placeholder="Search the site" class="h-14 w-full border-2 border-ink bg-white px-4 text-lg focus:outline-none" />
    <button type="submit" class="h-14 shrink-0 bg-crimson-700 px-6 text-lg font-bold text-white hover:bg-crimson-800">Search</button>
  </form>
  <ul class="measure mt-10 border-t-2 border-ink" role="list">
    {links.map(([label, href]) => (
      <li class="border-b border-paper-300"><a href={href} class="block py-3 text-lg font-semibold hover:text-crimson-700">{label}</a></li>
    ))}
  </ul>
</PageLayout>
