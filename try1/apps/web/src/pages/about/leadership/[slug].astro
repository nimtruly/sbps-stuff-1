---
import PageLayout from '../../../layouts/PageLayout.astro';
import Prose from '../../../components/ui/Prose.astro';
import { cms } from '../../../lib/cms';

export async function getStaticPaths() {
  const leaders = await cms.getLeaders();
  return leaders.map((l) => ({ params: { slug: l.id }, props: { leader: l } }));
}

const { leader } = Astro.props;
const others = (await cms.getLeaders()).filter((l) => l.id !== leader.id);
---

<PageLayout
  title={`Message from ${leader.name}`}
  description={`${leader.role}, ${leader.org}`}
  breadcrumbs={[
    { label: 'About', href: '/about/' },
    { label: 'Leadership', href: '/about/leadership/' },
    { label: leader.name, href: `/about/leadership/${leader.id}/` },
  ]}
>
  <div class="grid gap-12 lg:grid-cols-[minmax(0,68ch)_1fr] lg:gap-16">
    <article>
      <div class="mb-8 flex items-center gap-5 border-b-2 border-ink pb-6">
        {leader.photo && <img src={leader.photo} alt={`Portrait of ${leader.name}`} width="150" height="150" class="h-24 w-24 object-cover" />}
        <div>
          <p class="text-xl font-bold">{leader.name}</p>
          <p class="text-paper-700">{leader.role}, {leader.org}</p>
          {leader.credentials && <p class="text-sm text-paper-600">{leader.credentials}</p>}
        </div>
      </div>
      <Prose text={leader.message} />
    </article>
    <aside aria-labelledby="others-title">
      <div class="border-t-2 border-ink lg:sticky lg:top-36">
        <h2 id="others-title" class="py-3 text-xl font-bold">Other messages</h2>
        <ul class="border-t border-paper-300" role="list">
          {others.map((l) => (
            <li class="border-b border-paper-300">
              <a href={`/about/leadership/${l.id}/`} class="block py-3 hover:text-crimson-700">
                <span class="block font-semibold">{l.name}</span>
                <span class="block text-sm text-paper-600">{l.role}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</PageLayout>
