---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  excerpt?: string;
  category: string;
  categoryHref?: string;
  publishedAt: string;
  author?: string;
  coverImage?: string;
  tags?: string[];
  slug: string;
}

const {
  title,
  excerpt,
  category,
  categoryHref = `/blog/category/${category.toLowerCase().replace(/\s+/g, '-')}/`,
  publishedAt,
  author = 'Social Baluni Public School',
  coverImage,
  tags = [],
  slug,
} = Astro.props;

const dateFormatted = new Date(publishedAt).toLocaleDateString('en-IN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description: excerpt,
  image: coverImage ? [`https://www.sbpsdoon.com${coverImage}`] : undefined,
  datePublished: publishedAt,
  dateModified: publishedAt,
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'School',
    name: 'Social Baluni Public School',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.sbpsdoon.com/brand/sbps-logo.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://www.sbpsdoon.com/blog/${slug}/`,
  },
};
---

<BaseLayout title={`${title} | SBPS Dehradun`} description={excerpt} ogImage={coverImage} schema={articleSchema} type="article">
  <article>
    <div class="border-b-2 border-ink bg-paper-50">
      <div class="mx-auto max-w-7xl px-4 pb-10 pt-8 sm:px-6 lg:px-8 lg:pl-14">
        <nav class="mb-6 text-sm text-paper-600" aria-label="Breadcrumb">
          <ol class="flex flex-wrap gap-x-2" role="list">
            <li><a href="/" class="hover:text-crimson-700 hover:underline">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/blog/" class="hover:text-crimson-700 hover:underline">News</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={categoryHref} class="hover:text-crimson-700 hover:underline">{category}</a></li>
          </ol>
        </nav>
        <h1 class="max-w-4xl text-[2.5rem] font-extrabold sm:text-6xl">{title}</h1>
        <p class="mt-4 text-base text-paper-700">
          <time datetime={publishedAt}>{dateFormatted}</time> · {author}
        </p>
      </div>
    </div>
    <div class="tie-spine">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:pl-14">
        <div class="max-w-[68ch]">
          {excerpt && <p class="mb-8 text-xl font-medium text-paper-800">{excerpt}</p>}
          {coverImage && (
            <img src={coverImage} alt="" class="mb-10 aspect-[3/2] w-full object-cover" loading="eager" />
          )}
          <slot />
          {tags.length > 0 && (
            <p class="mt-12 border-t-2 border-ink pt-4 text-sm text-paper-600">Topics: {tags.join(', ')}</p>
          )}
          <a href="/blog/" class="mt-8 inline-block font-semibold underline">All news</a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
