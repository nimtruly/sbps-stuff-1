---
import { school } from '../../data/nav';
---

<nav class="fixed inset-x-0 bottom-0 z-40 border-t-2 border-ink bg-paper-50 lg:hidden" aria-label="Quick actions" data-mobile-bar>
  <ul class="grid h-16 grid-cols-4" role="list">
    <li>
      <a href={school.phoneHref} class="flex h-full flex-col items-center justify-center gap-1 text-ink active:bg-paper-200">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5.5 2.5h2.6l1.4 3.6-1.9 1.2a9.5 9.5 0 0 0 5.1 5.1l1.2-1.9 3.6 1.4v2.6a1.5 1.5 0 0 1-1.5 1.5A13.5 13.5 0 0 1 2.5 4 1.5 1.5 0 0 1 4 2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        </svg>
        <span class="text-[0.8125rem] font-semibold">Call</span>
      </a>
    </li>
    <li>
      <a href={`${school.whatsapp}?text=${encodeURIComponent('Hello SBPS, I would like to ask about admissions.')}`} rel="noopener" class="flex h-full flex-col items-center justify-center gap-1 text-ink active:bg-paper-200">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 2.5a7.5 7.5 0 0 0-6.5 11.2L2.5 17.5l3.9-1A7.5 7.5 0 1 0 10 2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          <path d="M7.4 7.2c.2-.5.5-.5.8-.5h.4l.7 1.6-.5.7c.5 1 1.3 1.8 2.3 2.3l.7-.5 1.6.7v.4c0 .3 0 .6-.5.8-.6.3-1.3.3-2-.1a7 7 0 0 1-3.4-3.4c-.4-.7-.4-1.4-.1-2Z" fill="currentColor" />
        </svg>
        <span class="text-[0.8125rem] font-semibold">WhatsApp</span>
      </a>
    </li>
    <li>
      <a href="/parents/pay-fees/" class="flex h-full flex-col items-center justify-center gap-1 bg-forest-700 text-white active:bg-forest-800">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <rect x="2.5" y="5" width="15" height="10" stroke="currentColor" stroke-width="1.6" />
          <path d="M2.5 8.5h15" stroke="currentColor" stroke-width="1.6" />
        </svg>
        <span class="text-[0.8125rem] font-semibold">Pay fees</span>
      </a>
    </li>
    <li>
      <a href="/admissions/enquire/" class="flex h-full flex-col items-center justify-center gap-1 bg-crimson-700 text-white active:bg-crimson-800">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 4.5h14v9H8l-4 3v-3H3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        </svg>
        <span class="text-[0.8125rem] font-semibold">Enquire</span>
      </a>
    </li>
  </ul>
</nav>
