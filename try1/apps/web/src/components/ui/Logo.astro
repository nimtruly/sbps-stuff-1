---
interface Props {
  variant?: 'full' | 'compact' | 'white';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;
const onDark = variant === 'white';
---

<a href="/" class={`group inline-flex items-center gap-3 text-left no-underline ${className}`}>
  <img
    src="/brand/crest-patch.webp"
    alt=""
    width="62"
    height="58"
    class="h-12 w-auto shrink-0 rounded-sm outline outline-2 outline-offset-2 outline-saffron-500"
  />
  <span class="flex flex-col leading-none">
    <span class={`font-display text-[1.375rem] font-bold tracking-tight [font-stretch:78%] ${onDark ? 'text-white' : 'text-ink'}`}>
      Social Baluni Public School
    </span>
    <span class={`mt-1 text-xs font-medium ${onDark ? 'text-crimson-100' : 'text-paper-600'}`}>
      Dehradun · CBSE Nursery to XII
    </span>
  </span>
</a>
