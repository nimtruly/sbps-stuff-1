# Global security headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://checkout.razorpay.com https://cdn.onesignal.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: https://*.ytimg.com https://*.sanity.io; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com https://api.razorpay.com https://lumberjack.razorpay.com https://onesignal.com https://cloudflareinsights.com; frame-src 'self' https://challenges.cloudflare.com https://api.razorpay.com https://www.youtube-nocookie.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self';

# Immutable cache for build assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache control for brand images & documents
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/documents/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
